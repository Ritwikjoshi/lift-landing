---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout 
  title="404 — Page Not Found · LIFT OS" 
  description="The requested diligence dossier, portal route, or document does not exist or has been relocated."
>
  <Navbar />
  <main class="flex-1 flex items-center justify-center py-20 sm:py-32">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 font-mono text-xs uppercase tracking-widest mb-6">
        HTTP 404 · Unresolved Destination
      </div>

      <h1 class="text-7xl sm:text-9xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-purple-400 to-blue-400 font-heading tracking-tight">
        404
      </h1>

      <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading mt-4">
        Diligence Endpoint Not Found
      </h2>

      <p class="mt-4 text-slate-400 text-sm sm:text-base leading-relaxed max-w-md mx-auto">
        The requested record, room identifier, or portal resource does not exist, has completed its retention cycle, or has been relocated.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/" class="w-full sm:w-auto px-6 py-3 rounded-xl font-semibold text-xs bg-gradient-to-r from-indigo-600 via-purple-600 to-blue-600 text-white shadow-[0_0_20px_rgba(99,102,241,0.5)] hover:shadow-[0_0_30px_rgba(99,102,241,0.8)] transition-all flex items-center justify-center gap-2">
          <span>Return to Homepage</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a href="/security" class="w-full sm:w-auto px-6 py-3 rounded-xl font-semibold text-xs glass-panel border border-white/10 hover:border-white/20 text-slate-300 hover:text-white transition-all flex items-center justify-center gap-2">
          <span>Security Architecture</span>
        </a>
      </div>

    </div>
  </main>
  <Footer />
</Layout>
