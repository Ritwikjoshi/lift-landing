---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout 
  title="Due Diligence Workstreams | LIFT DD Operating Platform" 
  description="Comprehensive due diligence coverage across 10 disciplines: Financial, Tax, Corporate, Legal, IP, Commercial, Technology, HR, Valuation, and Sector-specific diligence."
>
  <Navbar />
  
  <main class="flex-1 py-16 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      
      <!-- Section 25: Header -->
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-mono uppercase tracking-wider">
          Multi-Domain Coverage
        </div>
        <h1 class="text-3xl sm:text-5xl font-bold text-white font-heading tracking-tight">
          Comprehensive Due Diligence Workstreams
        </h1>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
          LIFT standardises requests, parameters, and evidence across all 10 core diligence disciplines. Connect specialists into a single unified operating rhythm.
        </p>
      </div>

      <!-- Detailed 10 Workstreams Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- 01 - FINANCIAL -->
        <div id="financial" class="glass-panel rounded-3xl p-8 border border-indigo-500/20 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-indigo-400 uppercase">WORKSTREAM 01</span>
            <span class="text-[10px] text-slate-400 font-mono">Specialist: CA / Financial Analyst</span>
          </div>
          <h2 class="text-2xl font-bold text-white font-heading">Financial Due Diligence</h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Examines the underlying quality of earnings, recurring revenue profiles, normalized EBITDA adjustments, working capital fluctuations, debt covenants, and cash runway.
          </p>
          <div class="space-y-2 pt-2 text-xs text-slate-400">
            <div class="font-semibold text-slate-200 uppercase text-[10px]">Key Checklist Parameters:</div>
            <div class="grid grid-cols-2 gap-2 text-[11px]">
              <div>• 3-Year Audited Financials</div>
              <div>• Monthly MIS & P&L Analysis</div>
              <div>• Normalised EBITDA Bridge</div>
              <div>• Debtor Aging & Provisions</div>
              <div>• Related-Party Transactions</div>
              <div>• Bank Statements Reconciliation</div>
            </div>
          </div>
        </div>

        <!-- 02 - TAX -->
        <div id="tax" class="glass-panel rounded-3xl p-8 border border-blue-500/20 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-blue-400 uppercase">WORKSTREAM 02</span>
            <span class="text-[10px] text-slate-400 font-mono">Specialist: Tax Practitioner / CA</span>
          </div>
          <h2 class="text-2xl font-bold text-white font-heading">Tax Due Diligence</h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Assesses historical and pending tax compliance across direct income tax, withholding/TDS, and GST/VAT, identifying hidden exposures or pending dispute demands.
          </p>
          <div class="space-y-2 pt-2 text-xs text-slate-400">
            <div class="font-semibold text-slate-200 uppercase text-[10px]">Key Checklist Parameters:</div>
            <div class="grid grid-cols-2 gap-2 text-[11px]">
              <div>• GSTR-1, 3B & 9 Reconciliations</div>
              <div>• Input Tax Credit (ITC) Scrutiny</div>
              <div>• TDS Filing & Form 26AS Match</div>
              <div>• Income Tax Assessment Orders</div>
              <div>• Transfer Pricing Documentation</div>
              <div>• Unclaimed Advance Tax Balances</div>
            </div>
          </div>
        </div>

        <!-- 03 - CORPORATE -->
        <div id="corporate" class="glass-panel rounded-3xl p-8 border border-purple-500/20 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-purple-400 uppercase">WORKSTREAM 03</span>
            <span class="text-[10px] text-slate-400 font-mono">Specialist: Practicing Company Secretary</span>
          </div>
          <h2 class="text-2xl font-bold text-white font-heading">Corporate & Secretarial DD</h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Reconciles statutory corporate records with the Registrar of Companies (ROC/MCA), verifying authorized vs issued capital, board resolutions, and statutory filings.
          </p>
          <div class="space-y-2 pt-2 text-xs text-slate-400">
            <div class="font-semibold text-slate-200 uppercase text-[10px]">Key Checklist Parameters:</div>
            <div class="grid grid-cols-2 gap-2 text-[11px]">
              <div>• Fully Diluted Cap Table Verification</div>
              <div>• PAS-3 / SH-7 Allotment Forms</div>
              <div>• ESOP Scheme & Grant Registers</div>
              <div>• Board & AGM Minutes Ledger</div>
              <div>• Director KYC & DIN Status</div>
              <div>• Registered Charges / Satisfactions</div>
            </div>
          </div>
        </div>

        <!-- 04 - LEGAL -->
        <div id="legal" class="glass-panel rounded-3xl p-8 border border-cyan-500/20 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-cyan-400 uppercase">WORKSTREAM 04</span>
            <span class="text-[10px] text-slate-400 font-mono">Specialist: Corporate Legal Counsel</span>
          </div>
          <h2 class="text-2xl font-bold text-white font-heading">Legal Due Diligence</h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Reviews material commercial contracts, non-standard indemnity clauses, active and threatened litigations across courts, and regulatory compliance permits.
          </p>
          <div class="space-y-2 pt-2 text-xs text-slate-400">
            <div class="font-semibold text-slate-200 uppercase text-[10px]">Key Checklist Parameters:</div>
            <div class="grid grid-cols-2 gap-2 text-[11px]">
              <div>• Top Customer Master Service SLAs</div>
              <div>• Supplier Agreements & Lock-ins</div>
              <div>• Litigation & Court Record Search</div>
              <div>• Change-of-Control Provisions</div>
              <div>• Non-Compete & Exclusivity</div>
              <div>• Statutory Licenses & Approvals</div>
            </div>
          </div>
        </div>

        <!-- 05 - IP -->
        <div id="ip" class="glass-panel rounded-3xl p-8 border border-emerald-500/20 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-emerald-400 uppercase">WORKSTREAM 05</span>
            <span class="text-[10px] text-slate-400 font-mono">Specialist: IP Attorney</span>
          </div>
          <h2 class="text-2xl font-bold text-white font-heading">Intellectual Property DD</h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Evaluates the ownership chain, registration status, assignment deeds, and vulnerability of patents, trademarks, copyrights, domain names, and trade secrets.
          </p>
          <div class="space-y-2 pt-2 text-xs text-slate-400">
            <div class="font-semibold text-slate-200 uppercase text-[10px]">Key Checklist Parameters:</div>
            <div class="grid grid-cols-2 gap-2 text-[11px]">
              <div>• Registered Patent Portfolio</div>
              <div>• Trademark Filing Opposition Status</div>
              <div>• Founder & Contractor IP Assignments</div>
              <div>• Third-Party Software Licensing</div>
              <div>• Proprietary Algorithm Trade Secrets</div>
              <div>• Infringement Claims & Disputes</div>
            </div>
          </div>
        </div>

        <!-- 06 - COMMERCIAL -->
        <div id="commercial" class="glass-panel rounded-3xl p-8 border border-amber-500/20 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-amber-400 uppercase">WORKSTREAM 06</span>
            <span class="text-[10px] text-slate-400 font-mono">Specialist: Commercial / Strategy Lead</span>
          </div>
          <h2 class="text-2xl font-bold text-white font-heading">Commercial Due Diligence</h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Analyses market size, customer cohort retention, sales efficiency, churn dynamics, pricing power, competitive positioning, and future revenue sustainability.
          </p>
          <div class="space-y-2 pt-2 text-xs text-slate-400">
            <div class="font-semibold text-slate-200 uppercase text-[10px]">Key Checklist Parameters:</div>
            <div class="grid grid-cols-2 gap-2 text-[11px]">
              <div>• Customer Churn & Cohort Retention</div>
              <div>• Customer Concentration Index</div>
              <div>• Total Addressable Market (TAM)</div>
              <div>• CAC to LTV Payback Metrics</div>
              <div>• Sales Pipeline Conversion Velocity</div>
              <div>• Competitive Moat Assessment</div>
            </div>
          </div>
        </div>

        <!-- 07 - TECH -->
        <div id="technology" class="glass-panel rounded-3xl p-8 border border-rose-500/20 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-rose-400 uppercase">WORKSTREAM 07</span>
            <span class="text-[10px] text-slate-400 font-mono">Specialist: Chief Technology Architect</span>
          </div>
          <h2 class="text-2xl font-bold text-white font-heading">Technology & Cybersecurity DD</h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Assesses system architecture scalability, codebase hygiene, cloud infrastructure expenses, dependency on deprecated libraries, and cybersecurity safeguards.
          </p>
          <div class="space-y-2 pt-2 text-xs text-slate-400">
            <div class="font-semibold text-slate-200 uppercase text-[10px]">Key Checklist Parameters:</div>
            <div class="grid grid-cols-2 gap-2 text-[11px]">
              <div>• Architecture & Tech Stack Audit</div>
              <div>• Open-Source (GPL/MIT) License Scan</div>
              <div>• Technical Debt & Refactoring Needs</div>
              <div>• Infrastructure Auto-Scale Health</div>
              <div>• Penetration Test & Vulnerability Logs</div>
              <div>• Disaster Recovery & Backups</div>
            </div>
          </div>
        </div>

        <!-- 08 - HR -->
        <div id="hr" class="glass-panel rounded-3xl p-8 border border-indigo-500/20 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-indigo-400 uppercase">WORKSTREAM 08</span>
            <span class="text-[10px] text-slate-400 font-mono">Specialist: HR & Employment Counsel</span>
          </div>
          <h2 class="text-2xl font-bold text-white font-heading">HR & Talent Due Diligence</h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Reviews key leadership employment terms, golden parachutes, employee turnover rates, ESOP vesting status, and mandatory provident fund / gratuity obligations.
          </p>
          <div class="space-y-2 pt-2 text-xs text-slate-400">
            <div class="font-semibold text-slate-200 uppercase text-[10px]">Key Checklist Parameters:</div>
            <div class="grid grid-cols-2 gap-2 text-[11px]">
              <div>• Founder & C-Suite Agreements</div>
              <div>• Non-Compete & Non-Solicit Clauses</div>
              <div>• Gratuity & Actuarial Valuation</div>
              <div>• PF, ESI, and Labour Compliances</div>
              <div>• ESOP Scheme Pool & Vesting</div>
              <div>• Contractor vs Employee Risk</div>
            </div>
          </div>
        </div>

        <!-- 09 - VALUATION -->
        <div id="valuation" class="glass-panel rounded-3xl p-8 border border-purple-500/20 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-purple-400 uppercase">WORKSTREAM 09</span>
            <span class="text-[10px] text-slate-400 font-mono">Specialist: Registered Valuer (IBBI)</span>
          </div>
          <h2 class="text-2xl font-bold text-white font-heading">Valuation & Financial Modeling</h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Provides rigorous valuation benchmarking using Discounted Cash Flow (DCF), Comparable Company Multiples, and precedent transaction analysis for regulatory and transaction needs.
          </p>
          <div class="space-y-2 pt-2 text-xs text-slate-400">
            <div class="font-semibold text-slate-200 uppercase text-[10px]">Key Checklist Parameters:</div>
            <div class="grid grid-cols-2 gap-2 text-[11px]">
              <div>• Financial Projection Stress Testing</div>
              <div>• DCF Model Sensitivity Analysis</div>
              <div>• Trading Multiples Benchmarking</div>
              <div>• FEMA / Rule 11UA Compliance</div>
              <div>• Intangible Asset Valuation</div>
              <div>• Pre-Money / Post-Money Waterfall</div>
            </div>
          </div>
        </div>

        <!-- 10 - DOMAIN -->
        <div id="domain" class="glass-panel rounded-3xl p-8 border border-emerald-500/20 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-emerald-400 uppercase">WORKSTREAM 10</span>
            <span class="text-[10px] text-slate-400 font-mono">Specialist: Industry Sector Expert</span>
          </div>
          <h2 class="text-2xl font-bold text-white font-heading">Domain & Sector Due Diligence</h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Tailored scrutiny across specialized sectors (e.g. Fintech, Medtech, Spacetech, Agritech, Defense, Manufacturing) covering sector-specific regulatory bodies and operating hurdles.
          </p>
          <div class="space-y-2 pt-2 text-xs text-slate-400">
            <div class="font-semibold text-slate-200 uppercase text-[10px]">Key Checklist Parameters:</div>
            <div class="grid grid-cols-2 gap-2 text-[11px]">
              <div>• RBI / SEBI / IRDAI Regulations</div>
              <div>• Clinical Trial & CDSCO Filings</div>
              <div>• Factory Act & Environmental Licenses</div>
              <div>• Export-Import (EXIM) Mandates</div>
              <div>• Industry ESG & Carbon Disclosures</div>
              <div>• Government Grant Benchmarks</div>
            </div>
          </div>
        </div>

      </div>

      <!-- Action Footer -->
      <div class="text-center pt-8 border-t border-white/10 space-y-4">
        <h3 class="text-2xl font-bold text-white font-heading">
          Need a multi-workstream diligence package for your next transaction?
        </h3>
        <div class="flex justify-center gap-4 pt-2">
          <a href="/contact?intent=start-dd" class="px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs transition-all shadow-md">
            Start a DD
          </a>
          <a href="/contact?intent=demo" class="px-6 py-3 rounded-xl bg-white/5 border border-white/10 text-slate-200 text-xs font-semibold hover:text-white transition-colors">
            Book a Demo
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
