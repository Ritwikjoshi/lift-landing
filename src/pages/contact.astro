---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout 
  title="Contact & Demo | LIFT Smart Due Diligence Platform" 
  description="Connect with the LIFT team. Initiate your next due diligence assignment or schedule a personalized platform walkthrough."
>
  <Navbar />
  
  <main class="flex-1 py-16 sm:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section 39: Contact Heading -->
      <div class="text-center max-w-2xl mx-auto mb-14">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-mono uppercase tracking-wider mb-3">
          Direct Engagement
        </div>
        <h1 class="text-3xl sm:text-5xl font-bold text-white font-heading tracking-tight">
          Ready to lift your DD process?
        </h1>
        <p class="mt-4 text-slate-300 text-sm sm:text-base leading-relaxed">
          Tell us about your next diligence assignment or book an institutional platform demonstration.
        </p>
      </div>

      <!-- Contact Form Container -->
      <div class="glass-panel-glow rounded-3xl p-6 sm:p-12 border border-white/10 shadow-2xl">
        <form id="contact-form" class="space-y-8">
          
          <!-- Contact Details Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-xs font-medium text-slate-300 mb-2">Full Name *</label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                required 
                placeholder="e.g. Vikram Mehta"
                class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-white/10 text-white text-xs placeholder:text-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all"
              />
            </div>

            <div>
              <label for="company" class="block text-xs font-medium text-slate-300 mb-2">Organization / Firm *</label>
              <input 
                type="text" 
                id="company" 
                name="company" 
                required 
                placeholder="e.g. Apex Growth Capital"
                class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-white/10 text-white text-xs placeholder:text-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all"
              />
            </div>

            <div>
              <label for="email" class="block text-xs font-medium text-slate-300 mb-2">Work Email *</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="vikram@apexgrowth.com"
                class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-white/10 text-white text-xs placeholder:text-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all"
              />
            </div>

            <div>
              <label for="phone" class="block text-xs font-medium text-slate-300 mb-2">Phone Number</label>
              <input 
                type="tel" 
                id="phone" 
                name="phone" 
                placeholder="+91 98765 43210"
                class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-white/10 text-white text-xs placeholder:text-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all"
              />
            </div>
          </div>

          <!-- Stakeholder Persona Selection (Section 39) -->
          <div>
            <label class="block text-xs font-medium text-slate-300 mb-2">I am a: *</label>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs">
              {[
                { id: 'role-investor', label: 'Investor (PE/VC/FO)' },
                { id: 'role-corporate', label: 'Corporate / M&A' },
                { id: 'role-founder', label: 'Founder / Venture' },
                { id: 'role-advisor', label: 'Advisor (CA/CS/Law)' },
                { id: 'role-incubator', label: 'Incubator / Accelerator' },
                { id: 'role-other', label: 'Other Stakeholder' }
              ].map((role, idx) => (
                <label class="flex items-center gap-2 p-3 rounded-xl bg-slate-900/60 border border-white/5 hover:border-indigo-500/30 cursor-pointer transition-all">
                  <input type="radio" name="persona" value={role.label} required checked={idx === 0} class="text-indigo-600 focus:ring-indigo-500 bg-slate-800" />
                  <span class="text-slate-200">{role.label}</span>
                </label>
              ))}
            </div>
          </div>

          <!-- Diligence Discipline Checklist (Section 39) -->
          <div>
            <label class="block text-xs font-medium text-slate-300 mb-2">What do you need help with? (Select all that apply)</label>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-xs">
              {[
                'Financial DD',
                'Tax DD',
                'Legal DD',
                'Corporate DD',
                'Commercial DD',
                'Technology DD',
                'IP DD',
                'Valuation',
                'Full DD Package',
                'LIFT Platform Demo',
                'Cohort Standardisation',
                'Other Requirement'
              ].map((workstream) => (
                <label class="flex items-center gap-2 p-2.5 rounded-lg bg-slate-900/60 border border-white/5 hover:border-indigo-500/20 cursor-pointer transition-all">
                  <input type="checkbox" name="services" value={workstream} class="rounded text-indigo-600 focus:ring-indigo-500 bg-slate-800" />
                  <span class="text-slate-300 text-[11px]">{workstream}</span>
                </label>
              ))}
            </div>
          </div>

          <!-- Requirement Text Area -->
          <div>
            <label for="notes" class="block text-xs font-medium text-slate-300 mb-2">Tell us about your requirement *</label>
            <textarea 
              id="notes" 
              name="notes" 
              rows="4" 
              required
              placeholder="Target industry, approximate transaction timeline, specific scope, or platform demo objectives..."
              class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-white/10 text-white text-xs placeholder:text-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all resize-none"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <div>
            <button 
              type="submit" 
              class="w-full py-4 rounded-xl font-semibold text-sm bg-gradient-to-r from-indigo-600 via-purple-600 to-blue-600 text-white shadow-[0_0_30px_rgba(99,102,241,0.5)] hover:shadow-[0_0_45px_rgba(99,102,241,0.8)] transition-all cursor-pointer"
            >
              Start the Conversation &rarr;
            </button>
            <p class="text-[11px] text-slate-400 text-center mt-3">
              All inquiries handled under strict confidentiality agreements. Response within 1 business day.
            </p>
          </div>

        </form>

        <!-- Instant Success Feedback Box -->
        <div id="form-success" class="hidden p-8 text-center space-y-4">
          <div class="w-12 h-12 rounded-full bg-emerald-500/10 text-emerald-400 mx-auto flex items-center justify-center font-bold text-xl border border-emerald-500/20">
            ✓
          </div>
          <h3 class="text-xl font-bold text-white font-heading">Inquiry Received</h3>
          <p class="text-xs text-slate-300 max-w-md mx-auto leading-relaxed">
            Thank you for reaching out to LIFT. Our transaction solutions lead will review your scope and get in touch shortly with next steps.
          </p>
        </div>

      </div>

      <!-- Direct Contact Card -->
      <div class="mt-12 text-center text-xs text-slate-400 space-y-2">
        <p>Direct Inquiries: <a href="mailto:contact@lift.business" class="text-indigo-400 hover:underline">contact@lift.business</a></p>
        <p>LIFT Operating Platform • Operated by GGAM Advisory</p>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successBox = document.getElementById('form-success');

  if (form && successBox) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.classList.add('hidden');
      successBox.classList.remove('hidden');
    });
  }
</script>
