---
---

<section id="simulator" class="py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-indigo-400 mb-3">Live Interactive Due Diligence Simulator</h2>
      <p class="text-3xl sm:text-5xl font-bold text-white font-heading tracking-tight">
        Experience Real-Time Diligence Scoring
      </p>
      <p class="mt-4 text-base sm:text-lg text-slate-300">
        Toggle verification documents below to watch the institutional risk radar and diligence index recalibrate instantly.
      </p>
    </div>

    <!-- Simulator Interactive Box -->
    <div class="glass-panel-glow rounded-3xl p-6 sm:p-10 border border-indigo-500/20 max-w-5xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Left Column: Checkbox Checklist -->
        <div class="lg:col-span-7 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-white/10">
            <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Institutional Verification Checklist</span>
            <span class="text-[11px] text-indigo-400 font-mono">5 CORE PILLARS</span>
          </div>

          <!-- Item 1 -->
          <label class="flex items-center justify-between p-3.5 rounded-xl bg-slate-900/80 border border-white/5 hover:border-indigo-500/30 cursor-pointer transition-all group">
            <div class="flex items-center gap-3">
              <input type="checkbox" checked data-weight="25" class="dd-check w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 bg-slate-800 border-white/20" />
              <div>
                <div class="text-sm font-semibold text-white group-hover:text-indigo-200 transition-colors">Audited P&L & 3-Year Tax Filings</div>
                <div class="text-xs text-slate-400">Reconciled GST returns & EBITDA verification (+25 Pts)</div>
              </div>
            </div>
            <span class="text-xs font-mono text-emerald-400 font-medium">Financial</span>
          </label>

          <!-- Item 2 -->
          <label class="flex items-center justify-between p-3.5 rounded-xl bg-slate-900/80 border border-white/5 hover:border-indigo-500/30 cursor-pointer transition-all group">
            <div class="flex items-center gap-3">
              <input type="checkbox" checked data-weight="25" class="dd-check w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 bg-slate-800 border-white/20" />
              <div>
                <div class="text-sm font-semibold text-white group-hover:text-indigo-200 transition-colors">MCA Registry & Cap Table Match</div>
                <div class="text-xs text-slate-400">Fully diluted equity & ESOP pool documentation (+25 Pts)</div>
              </div>
            </div>
            <span class="text-xs font-mono text-purple-400 font-medium">Corporate</span>
          </label>

          <!-- Item 3 -->
          <label class="flex items-center justify-between p-3.5 rounded-xl bg-slate-900/80 border border-white/5 hover:border-indigo-500/30 cursor-pointer transition-all group">
            <div class="flex items-center gap-3">
              <input type="checkbox" checked data-weight="20" class="dd-check w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 bg-slate-800 border-white/20" />
              <div>
                <div class="text-sm font-semibold text-white group-hover:text-indigo-200 transition-colors">Clean Litigation & Court Record Scan</div>
                <div class="text-xs text-slate-400">Zero active disputes across High Courts & Tribunals (+20 Pts)</div>
              </div>
            </div>
            <span class="text-xs font-mono text-blue-400 font-medium">Legal</span>
          </label>

          <!-- Item 4 -->
          <label class="flex items-center justify-between p-3.5 rounded-xl bg-slate-900/80 border border-white/5 hover:border-indigo-500/30 cursor-pointer transition-all group">
            <div class="flex items-center gap-3">
              <input type="checkbox" data-weight="15" class="dd-check w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 bg-slate-800 border-white/20" />
              <div>
                <div class="text-sm font-semibold text-white group-hover:text-indigo-200 transition-colors">Intellectual Property & Source Code Escrow</div>
                <div class="text-xs text-slate-400">Patents registered & dev assignment covenants (+15 Pts)</div>
              </div>
            </div>
            <span class="text-xs font-mono text-amber-400 font-medium">IP & Tech</span>
          </label>

          <!-- Item 5 -->
          <label class="flex items-center justify-between p-3.5 rounded-xl bg-slate-900/80 border border-white/5 hover:border-indigo-500/30 cursor-pointer transition-all group">
            <div class="flex items-center gap-3">
              <input type="checkbox" data-weight="15" class="dd-check w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 bg-slate-800 border-white/20" />
              <div>
                <div class="text-sm font-semibold text-white group-hover:text-indigo-200 transition-colors">Key Customer & Supplier Master Contracts</div>
                <div class="text-xs text-slate-400">Top 5 customer contracts with non-assignment waivers (+15 Pts)</div>
              </div>
            </div>
            <span class="text-xs font-mono text-pink-400 font-medium">Commercial</span>
          </label>
        </div>

        <!-- Right Column: Live Scoring Engine Output -->
        <div class="lg:col-span-5 bg-[#080d1a] rounded-2xl p-6 border border-indigo-500/30 text-center flex flex-col items-center justify-center relative overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-b from-indigo-500/10 via-transparent to-transparent pointer-events-none"></div>

          <div class="relative z-10 w-full">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Calculated Diligence Index</span>
            
            <!-- Circular Gauge or Big Number -->
            <div class="my-6">
              <div class="text-6xl sm:text-7xl font-bold tracking-tight text-white font-heading font-mono" id="score-display">
                70<span class="text-2xl text-slate-400 font-normal">/100</span>
              </div>
              <div class="mt-2 text-xs font-semibold px-3 py-1 rounded-full inline-block" id="rating-badge">
                GRADE A: READY FOR INVESTMENT COMMITTEE
              </div>
            </div>

            <!-- Status Indicator -->
            <div class="w-full bg-slate-800/80 h-3 rounded-full overflow-hidden mb-6">
              <div id="score-progress" class="bg-gradient-to-r from-indigo-500 via-purple-500 to-emerald-400 h-full w-[70%] transition-all duration-500 rounded-full"></div>
            </div>

            <div class="grid grid-cols-2 gap-3 text-left w-full pt-4 border-t border-white/10 text-xs">
              <div>
                <span class="text-slate-400 block">Risk Status:</span>
                <span id="risk-status" class="text-emerald-400 font-medium font-mono">Moderate / Controlled</span>
              </div>
              <div>
                <span class="text-slate-400 block">Syndication Path:</span>
                <span id="syndicate-status" class="text-indigo-300 font-medium font-mono">Fast-Track Eligible</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  function setupSimulator() {
    const checkboxes = document.querySelectorAll<HTMLInputElement>('.dd-check');
    const scoreDisplay = document.getElementById('score-display');
    const ratingBadge = document.getElementById('rating-badge');
    const scoreProgress = document.getElementById('score-progress');
    const riskStatus = document.getElementById('risk-status');
    const syndicateStatus = document.getElementById('syndicate-status');

    function calculate() {
      let score = 0;
      checkboxes.forEach((cb) => {
        if (cb.checked) {
          score += parseInt(cb.getAttribute('data-weight') || '0', 10);
        }
      });

      if (scoreDisplay) {
        scoreDisplay.innerHTML = `${score}<span class="text-2xl text-slate-400 font-normal">/100</span>`;
      }

      if (scoreProgress) {
        scoreProgress.style.width = `${score}%`;
      }

      if (ratingBadge && riskStatus && syndicateStatus) {
        if (score >= 85) {
          ratingBadge.textContent = 'GRADE AAA: PRE-APPROVED FOR CLOSING';
          ratingBadge.className = 'mt-2 text-xs font-semibold px-3 py-1 rounded-full inline-block bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
          riskStatus.textContent = 'Ultra-Low Institutional Risk';
          riskStatus.className = 'text-emerald-400 font-medium font-mono';
          syndicateStatus.textContent = 'Immediate IC Allocation';
        } else if (score >= 60) {
          ratingBadge.textContent = 'GRADE A: READY FOR INVESTMENT COMMITTEE';
          ratingBadge.className = 'mt-2 text-xs font-semibold px-3 py-1 rounded-full inline-block bg-indigo-500/20 text-indigo-300 border border-indigo-500/30';
          riskStatus.textContent = 'Moderate / Controlled';
          riskStatus.className = 'text-indigo-400 font-medium font-mono';
          syndicateStatus.textContent = 'Fast-Track Eligible';
        } else {
          ratingBadge.textContent = 'ACTION REQUIRED: REMEDIATION PENDING';
          ratingBadge.className = 'mt-2 text-xs font-semibold px-3 py-1 rounded-full inline-block bg-amber-500/20 text-amber-300 border border-amber-500/30';
          riskStatus.textContent = 'Unverified Checkpoints Present';
          riskStatus.className = 'text-amber-400 font-medium font-mono';
          syndicateStatus.textContent = 'Manual Review Mandate';
        }
      }
    }

    checkboxes.forEach((cb) => {
      cb.addEventListener('change', calculate);
    });

    calculate();
  }

  // Run on mount
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSimulator);
  } else {
    setupSimulator();
  }
</script>
