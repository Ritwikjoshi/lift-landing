<section id="governance" class="py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="glass-panel-glow rounded-3xl p-8 sm:p-14 border border-white/10 relative overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7">
          <span class="text-xs font-semibold uppercase tracking-widest text-indigo-400">Institutional Governance</span>
          <h2 class="text-2xl sm:text-4xl font-bold text-white font-heading mt-2">
            Built for Regulated Due Diligence & Confidential Transactions
          </h2>
          <p class="mt-4 text-slate-300 text-sm sm:text-base leading-relaxed">
            LIFT adheres to strict institutional confidentiality standards. Venture data is siloed cryptographically with zero cross-tenant visibility, complete audit immutability, and enterprise RBAC.
          </p>

          <div class="mt-8 grid grid-cols-2 sm:grid-cols-3 gap-6">
            <div>
              <div class="text-xl font-bold text-white font-mono">AES-256</div>
              <div class="text-xs text-slate-400 mt-1">At-Rest & Transit Encryption</div>
            </div>
            <div>
              <div class="text-xl font-bold text-indigo-400 font-mono">ISO 27001</div>
              <div class="text-xs text-slate-400 mt-1">Ready Controls Architecture</div>
            </div>
            <div>
              <div class="text-xl font-bold text-purple-400 font-mono">SOC 2 Type II</div>
              <div class="text-xs text-slate-400 mt-1">Compliant Data Isolation</div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 bg-slate-900/90 rounded-2xl p-6 border border-white/10 space-y-4">
          <div class="text-xs font-semibold uppercase tracking-wider text-slate-300 border-b border-white/10 pb-3">
            Security & Compliance Attestations
          </div>

          <div class="space-y-3">
            <div class="flex items-center gap-3 text-xs text-slate-200">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>Granular Role-Based Access Control (RBAC)</span>
            </div>
            <div class="flex items-center gap-3 text-xs text-slate-200">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>Tamper-Evident Immutable Audit Trails</span>
            </div>
            <div class="flex items-center gap-3 text-xs text-slate-200">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>Dynamically Watermarked Document Previews</span>
            </div>
            <div class="flex items-center gap-3 text-xs text-slate-200">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>Direct Subdomain Isolation for Partners</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
