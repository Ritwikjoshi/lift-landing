---
// src/components/Logo.astro
interface Props {
  size?: number;
  className?: string;
  showWordmark?: boolean;
  byline?: boolean;
}

const { size = 38, className = "", showWordmark = true, byline = true } = Astro.props;
---

<div class={`inline-flex items-center gap-3 ${className}`}>
  <!-- Elegant Kinetic LIFT Monogram Mark -->
  <div 
    class="relative flex items-center justify-center rounded-xl bg-gradient-to-br from-[#8b5cf6] via-[#7c3aed] to-[#4c1d95] shadow-[0_4px_16px_rgba(139,92,246,0.35)] transition-all duration-300 group-hover:shadow-[0_6px_22px_rgba(139,92,246,0.5)] group-hover:scale-105 select-none"
    style={`width: ${size}px; height: ${size}px; min-width: ${size}px; min-height: ${size}px;`}
  >
    <!-- Soft inner glass lighting ring -->
    <div class="absolute inset-0 rounded-xl ring-1 ring-white/25 pointer-events-none"></div>

    <svg
      width={Math.round(size * 0.72)}
      height={Math.round(size * 0.72)}
      viewBox="0 0 48 48"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="relative z-10"
    >
      <defs>
        <!-- Vertical Architectural Stem Gradient -->
        <linearGradient id="navStemGrad" x1="12" y1="8" x2="20" y2="30" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#ffffff" />
          <stop offset="70%" stop-color="#ede9fe" />
          <stop offset="100%" stop-color="#c4b5fd" />
        </linearGradient>

        <!-- Dynamic Kinetic Wing / Base Stroke Gradient -->
        <linearGradient id="navWingGrad" x1="12" y1="26" x2="36" y2="36" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#38bdf8" />
          <stop offset="50%" stop-color="#818cf8" />
          <stop offset="100%" stop-color="#f472b6" />
        </linearGradient>

        <!-- Upward Kinetic Ray Accent -->
        <linearGradient id="navRayGrad" x1="24" y1="10" x2="38" y2="20" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95" />
          <stop offset="100%" stop-color="#d8b4fe" stop-opacity="0.4" />
        </linearGradient>
      </defs>

      <!-- 1. Vertical Architectural Stem of 'L' -->
      <path
        d="M12 10C12 8.89543 12.8954 8 14 8H18.5C19.6046 8 20.5 8.89543 20.5 10V28C20.5 29.1046 19.6046 30 18.5 30H14C12.8954 30 12 29.1046 12 28V10Z"
        fill="url(#navStemGrad)"
      />

      <!-- 2. Kinetic Forward Base Wing of 'L' -->
      <path
        d="M12 28C12 26.8954 12.8954 26 14 26H33C34.9 26 36.1 27.8 35.5 29.6L34.1 33.6C33.7 34.8 32.6 35.6 31.4 35.6H14C12.8954 35.6 12 34.7046 12 33.6V28Z"
        fill="url(#navWingGrad)"
      />

      <!-- 3. Upward Elevation Arrow / LIFT Ray -->
      <path
        d="M24 20L31.2 10.4C32 9.3 33.6 9.3 34.4 10.4L37.8 14.8C38.6 15.8 38 17.2 36.7 17.2H25.8C24.5 17.2 23.5 18.5 24 20Z"
        fill="url(#navRayGrad)"
      />
    </svg>
  </div>

  <!-- Wordmark & Byline -->
  {showWordmark && (
    <div class="flex flex-col">
      <span class="text-xl font-bold tracking-tight text-slate-900 flex items-center gap-1.5 font-heading">
        LIFT
        <span class="text-[9px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded-md bg-violet-50 text-violet-700 border border-violet-200 font-mono">
          DD OS
        </span>
      </span>
      {byline && (
        <span class="text-[10px] tracking-widest uppercase text-slate-500 font-semibold -mt-0.5 font-sans">
          By GGAM Advisory
        </span>
      )}
    </div>
  )}
</div>
