---
// src/components/FlashDDSection.astro
---

<section id="flash-dd" class="py-24 relative overflow-hidden bg-slate-50/70 border-t border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section 22: Signature Feature Heading -->
    <div class="max-w-3xl mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-amber-50 border border-amber-200 text-amber-700 text-xs font-mono uppercase tracking-wider font-semibold">
        Signature LIFT Capability // Continuous Discovery
      </div>
      <h2 class="text-3xl sm:text-5xl font-bold text-slate-900 font-heading tracking-tight mt-3">
        Don't wait for the final report to know what matters.
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
        Flash DD™ provides an evolving view of important findings as the diligence progresses—giving investment committees and transaction teams real-time clarity rather than late-stage surprises.
      </p>
    </div>

    <!-- Section 22: Realistic Interactive Demo Dashboard -->
    <div class="rounded-3xl bg-white p-6 sm:p-10 border border-slate-200 shadow-xl">
      
      <!-- Dashboard Top Status Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-slate-100 gap-4">
        <div>
          <div class="flex items-center gap-3">
            <h3 class="text-xl sm:text-2xl font-bold text-slate-900 font-heading">TechFlow Robotics Pvt. Ltd.</h3>
            <span class="px-2.5 py-0.5 rounded-full bg-violet-50 text-violet-700 border border-violet-200 text-[10px] font-mono font-medium">
              DD Status: In Progress
            </span>
          </div>
          <p class="text-xs text-slate-500 mt-1">Multi-Workstream Coordinated Diligence Dossier // Lead: GGAM Advisory</p>
        </div>

        <div class="flex items-center gap-2 text-xs">
          <span class="text-[10px] font-mono text-slate-500 px-2 py-1 rounded bg-slate-100 border border-slate-200">
            Demonstration Interface Data
          </span>
        </div>
      </div>

      <!-- Section 22 & 49: KPI Row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3 mt-6">
        
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80">
          <span class="text-[10px] font-mono uppercase text-slate-500 block">DD Completion</span>
          <span class="text-xl sm:text-2xl font-bold text-slate-900 font-mono mt-1 block">72%</span>
          <span class="text-[10px] text-emerald-700 font-medium mt-0.5 block">On track</span>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80">
          <span class="text-[10px] font-mono uppercase text-slate-500 block">Documents</span>
          <span class="text-xl sm:text-2xl font-bold text-violet-700 font-mono mt-1 block">184<span class="text-xs text-slate-400">/230</span></span>
          <span class="text-[10px] text-slate-500 mt-0.5 block">80% Ingested</span>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80">
          <span class="text-[10px] font-mono uppercase text-slate-500 block">Parameters</span>
          <span class="text-xl sm:text-2xl font-bold text-blue-700 font-mono mt-1 block">64<span class="text-xs text-slate-400">/90</span></span>
          <span class="text-[10px] text-slate-500 mt-0.5 block">Scope reviewed</span>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80">
          <span class="text-[10px] font-mono uppercase text-slate-500 block">Open Queries</span>
          <span class="text-xl sm:text-2xl font-bold text-amber-600 font-mono mt-1 block">23</span>
          <span class="text-[10px] text-amber-700 font-medium mt-0.5 block">Across 4 streams</span>
        </div>

        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200">
          <span class="text-[10px] font-mono uppercase text-rose-700 font-semibold block">Critical</span>
          <span class="text-xl sm:text-2xl font-bold text-rose-700 font-mono mt-1 block">04</span>
          <span class="text-[10px] text-rose-600 font-medium mt-0.5 block">Material items</span>
        </div>

        <div class="p-4 rounded-xl bg-amber-50 border border-amber-200">
          <span class="text-[10px] font-mono uppercase text-amber-700 font-semibold block">High-Risk</span>
          <span class="text-xl sm:text-2xl font-bold text-amber-700 font-mono mt-1 block">11</span>
          <span class="text-[10px] text-amber-600 font-medium mt-0.5 block">Remediations</span>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80">
          <span class="text-[10px] font-mono uppercase text-slate-500 block">Experts</span>
          <span class="text-xl sm:text-2xl font-bold text-purple-700 font-mono mt-1 block">8</span>
          <span class="text-[10px] text-slate-500 mt-0.5 block">Engaged active</span>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80">
          <span class="text-[10px] font-mono uppercase text-slate-500 block">Pending Info</span>
          <span class="text-xl sm:text-2xl font-bold text-slate-700 font-mono mt-1 block">17</span>
          <span class="text-[10px] text-slate-500 mt-0.5 block">Awaiting upload</span>
        </div>

      </div>

      <!-- Section 23: Flash Findings Cards -->
      <div class="mt-8 pt-8 border-t border-slate-100">
        <div class="flex items-center justify-between mb-4">
          <h4 class="text-sm font-bold uppercase tracking-wider text-slate-900 font-heading">
            Live Flash Findings Stream
          </h4>
          <span class="text-[11px] text-slate-500 font-mono">Evidence-linked observations</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          
          <!-- FINANCIAL -->
          <div class="p-4 rounded-xl bg-white border border-rose-200 shadow-xs flex flex-col justify-between space-y-3">
            <div>
              <div class="flex items-center justify-between text-[10px] font-mono mb-2">
                <span class="px-2 py-0.5 rounded bg-rose-50 text-rose-700 border border-rose-200 font-bold uppercase">FINANCIAL // CRITICAL</span>
                <span class="text-slate-400">#F-01</span>
              </div>
              <p class="text-xs text-slate-800 leading-relaxed font-medium">
                Customer concentration identified as a key revenue risk (Top 2 clients represent 62% of ARR).
              </p>
            </div>
            <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[11px]">
              <span class="text-slate-500 font-mono text-[10px]">Expert: CA / Financial</span>
              <a href="#reporting" class="text-violet-700 hover:text-violet-800 font-semibold">View Finding &rarr;</a>
            </div>
          </div>

          <!-- CORPORATE -->
          <div class="p-4 rounded-xl bg-white border border-amber-200 shadow-xs flex flex-col justify-between space-y-3">
            <div>
              <div class="flex items-center justify-between text-[10px] font-mono mb-2">
                <span class="px-2 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200 font-bold uppercase">CORPORATE // HIGH</span>
                <span class="text-slate-400">#C-03</span>
              </div>
              <p class="text-xs text-slate-800 leading-relaxed font-medium">
                Shareholding documentation requires reconciliation against MCA Form PAS-3 allotment register.
              </p>
            </div>
            <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[11px]">
              <span class="text-slate-500 font-mono text-[10px]">Expert: Company Secretary</span>
              <a href="#reporting" class="text-violet-700 hover:text-violet-800 font-semibold">View Finding &rarr;</a>
            </div>
          </div>

          <!-- IP -->
          <div class="p-4 rounded-xl bg-white border border-amber-200 shadow-xs flex flex-col justify-between space-y-3">
            <div>
              <div class="flex items-center justify-between text-[10px] font-mono mb-2">
                <span class="px-2 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200 font-bold uppercase">IP // HIGH</span>
                <span class="text-slate-400">#IP-02</span>
              </div>
              <p class="text-xs text-slate-800 leading-relaxed font-medium">
                IP assignment documentation requires formal developer covenant addendums for overseas contractors.
              </p>
            </div>
            <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[11px]">
              <span class="text-slate-500 font-mono text-[10px]">Expert: IP Legal Counsel</span>
              <a href="#reporting" class="text-violet-700 hover:text-violet-800 font-semibold">View Finding &rarr;</a>
            </div>
          </div>

          <!-- TECHNOLOGY -->
          <div class="p-4 rounded-xl bg-white border border-blue-200 shadow-xs flex flex-col justify-between space-y-3">
            <div>
              <div class="flex items-center justify-between text-[10px] font-mono mb-2">
                <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200 font-bold uppercase">TECH // MEDIUM</span>
                <span class="text-slate-400">#T-04</span>
              </div>
              <p class="text-xs text-slate-800 leading-relaxed font-medium">
                Proprietary core SDK relies on deprecated open-source library requiring migration path.
              </p>
            </div>
            <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[11px]">
              <span class="text-slate-500 font-mono text-[10px]">Expert: Tech Architect</span>
              <a href="#reporting" class="text-violet-700 hover:text-violet-800 font-semibold">View Finding &rarr;</a>
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- Section 24: DD Control Tower -->
    <div id="control-tower" class="mt-20 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-5 space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-violet-50 border border-violet-200 text-violet-700 text-xs font-mono uppercase tracking-wider font-semibold">
          Leadership Visibility
        </div>
        <h3 class="text-2xl sm:text-4xl font-bold text-slate-900 font-heading tracking-tight">
          See the entire DD at a glance.
        </h3>
        <p class="text-slate-600 text-sm leading-relaxed">
          LIFT gives transaction leads, fund partners, and corporate M&A heads an unvarnished, live cockpit across all active workstreams, experts, open queries, and upcoming transaction milestones.
        </p>

        <div class="space-y-2 pt-2 text-xs text-slate-700">
          <div class="flex items-center gap-2">
            <span class="text-violet-600 font-bold">✓</span>
            <span>Live workstream progress tracking across 10 disciplines</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-violet-600 font-bold">✓</span>
            <span>Real-time risk heatmap with severity breakdown</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-violet-600 font-bold">✓</span>
            <span>Pending information bottlenecks surfaced automatically</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-violet-600 font-bold">✓</span>
            <span>Single-click export to investment committee memos</span>
          </div>
        </div>
      </div>

      <!-- Control Tower Matrix Visual -->
      <div class="lg:col-span-7 bg-white rounded-2xl p-6 border border-slate-200 shadow-md space-y-4">
        <div class="flex justify-between items-center text-xs pb-3 border-b border-slate-100">
          <span class="font-semibold text-slate-900">Workstream Progress & Risk Matrix</span>
          <span class="text-[10px] font-mono text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 font-medium">All Streams Synchronised</span>
        </div>

        <div class="space-y-3">
          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-700 font-medium">Financial DD (Controls, P&L, Audit)</span>
              <span class="text-slate-900 font-mono font-semibold">82% • 1 Critical Risk</span>
            </div>
            <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
              <div class="bg-gradient-to-r from-violet-600 to-fuchsia-600 h-full w-[82%]"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-700 font-medium">Tax DD (GST, Income Tax, Assessments)</span>
              <span class="text-slate-900 font-mono font-semibold">78% • Low Risk</span>
            </div>
            <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
              <div class="bg-blue-600 h-full w-[78%]"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-700 font-medium">Corporate & ROC (MCA, Cap Table, Filings)</span>
              <span class="text-slate-900 font-mono font-semibold">90% • 1 High Risk</span>
            </div>
            <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
              <div class="bg-purple-600 h-full w-[90%]"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-700 font-medium">Legal & Material Contracts (Litigation)</span>
              <span class="text-slate-900 font-mono font-semibold">68% • Moderate</span>
            </div>
            <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
              <div class="bg-cyan-600 h-full w-[68%]"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
