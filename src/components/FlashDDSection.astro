---
// src/components/FlashDDSection.astro
---

<section id="flash-dd" class="py-24 relative overflow-hidden bg-[#060814] border-t border-b border-white/[0.06]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section 22: Signature Feature Heading -->
    <div class="max-w-3xl mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-mono uppercase tracking-wider">
        Signature LIFT Capability // Continuous Discovery
      </div>
      <h2 class="text-3xl sm:text-5xl font-bold text-white font-heading tracking-tight mt-3">
        Don't wait for the final report to know what matters.
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
        Flash DD™ provides an evolving view of important findings as the diligence progresses—giving investment committees and transaction teams real-time clarity rather than late-stage surprises.
      </p>
    </div>

    <!-- Section 22: Realistic Interactive Demo Dashboard -->
    <div class="rounded-3xl glass-panel-glow p-6 sm:p-10 border border-indigo-500/25 shadow-[0_20px_60px_rgba(0,0,0,0.8)]">
      
      <!-- Dashboard Top Status Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-white/10 gap-4">
        <div>
          <div class="flex items-center gap-3">
            <h3 class="text-xl sm:text-2xl font-bold text-white font-heading">TechFlow Robotics Pvt. Ltd.</h3>
            <span class="px-2.5 py-0.5 rounded-full bg-indigo-500/10 text-indigo-300 border border-indigo-500/20 text-[10px] font-mono">
              DD Status: In Progress
            </span>
          </div>
          <p class="text-xs text-slate-400 mt-1">Multi-Workstream Coordinated Diligence Dossier // Lead: GGAM Advisory</p>
        </div>

        <div class="flex items-center gap-2 text-xs">
          <span class="text-[10px] font-mono text-slate-400 px-2 py-1 rounded bg-white/5 border border-white/5">
            Demonstration Interface Data
          </span>
        </div>
      </div>

      <!-- Section 22 & 49: KPI Row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3 mt-6">
        
        <div class="p-4 rounded-xl bg-slate-900/80 border border-white/5">
          <span class="text-[10px] font-mono uppercase text-slate-400 block">DD Completion</span>
          <span class="text-xl sm:text-2xl font-bold text-white font-mono mt-1 block">72%</span>
          <span class="text-[10px] text-emerald-400 mt-0.5 block">On track</span>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/80 border border-white/5">
          <span class="text-[10px] font-mono uppercase text-slate-400 block">Documents</span>
          <span class="text-xl sm:text-2xl font-bold text-indigo-300 font-mono mt-1 block">184<span class="text-xs text-slate-500">/230</span></span>
          <span class="text-[10px] text-slate-400 mt-0.5 block">80% Ingested</span>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/80 border border-white/5">
          <span class="text-[10px] font-mono uppercase text-slate-400 block">Parameters</span>
          <span class="text-xl sm:text-2xl font-bold text-blue-300 font-mono mt-1 block">64<span class="text-xs text-slate-500">/90</span></span>
          <span class="text-[10px] text-slate-400 mt-0.5 block">Scope reviewed</span>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/80 border border-white/5">
          <span class="text-[10px] font-mono uppercase text-slate-400 block">Open Queries</span>
          <span class="text-xl sm:text-2xl font-bold text-amber-300 font-mono mt-1 block">23</span>
          <span class="text-[10px] text-amber-400/80 mt-0.5 block">Across 4 streams</span>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/80 border border-rose-500/20 bg-rose-500/5">
          <span class="text-[10px] font-mono uppercase text-rose-300 block">Critical</span>
          <span class="text-xl sm:text-2xl font-bold text-rose-400 font-mono mt-1 block">04</span>
          <span class="text-[10px] text-rose-300/80 mt-0.5 block">Material items</span>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/80 border border-white/5">
          <span class="text-[10px] font-mono uppercase text-amber-300 block">High-Risk</span>
          <span class="text-xl sm:text-2xl font-bold text-amber-400 font-mono mt-1 block">11</span>
          <span class="text-[10px] text-slate-400 mt-0.5 block">Remediations</span>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/80 border border-white/5">
          <span class="text-[10px] font-mono uppercase text-slate-400 block">Experts</span>
          <span class="text-xl sm:text-2xl font-bold text-purple-300 font-mono mt-1 block">8</span>
          <span class="text-[10px] text-slate-400 mt-0.5 block">Engaged active</span>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/80 border border-white/5">
          <span class="text-[10px] font-mono uppercase text-slate-400 block">Pending Info</span>
          <span class="text-xl sm:text-2xl font-bold text-slate-300 font-mono mt-1 block">17</span>
          <span class="text-[10px] text-slate-400 mt-0.5 block">Awaiting upload</span>
        </div>

      </div>

      <!-- Section 23: Flash Findings Cards -->
      <div class="mt-8 pt-8 border-t border-white/10">
        <div class="flex items-center justify-between mb-4">
          <h4 class="text-sm font-bold uppercase tracking-wider text-slate-300 font-heading">
            Live Flash Findings Stream
          </h4>
          <span class="text-[11px] text-slate-400 font-mono">Evidence-linked observations</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          
          <!-- FINANCIAL -->
          <div class="p-4 rounded-xl bg-slate-900/90 border border-rose-500/20 flex flex-col justify-between space-y-3">
            <div>
              <div class="flex items-center justify-between text-[10px] font-mono mb-2">
                <span class="px-2 py-0.5 rounded bg-rose-500/10 text-rose-300 font-bold uppercase">FINANCIAL // CRITICAL</span>
                <span class="text-slate-500">#F-01</span>
              </div>
              <p class="text-xs text-slate-200 leading-relaxed font-medium">
                Customer concentration identified as a key revenue risk (Top 2 clients represent 62% of ARR).
              </p>
            </div>
            <div class="pt-2 border-t border-white/5 flex items-center justify-between text-[11px]">
              <span class="text-slate-400 font-mono text-[10px]">Expert: CA / Financial</span>
              <a href="#reporting" class="text-indigo-400 hover:text-indigo-300 font-semibold">View Finding &rarr;</a>
            </div>
          </div>

          <!-- CORPORATE -->
          <div class="p-4 rounded-xl bg-slate-900/90 border border-amber-500/20 flex flex-col justify-between space-y-3">
            <div>
              <div class="flex items-center justify-between text-[10px] font-mono mb-2">
                <span class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-300 font-bold uppercase">CORPORATE // HIGH</span>
                <span class="text-slate-500">#C-03</span>
              </div>
              <p class="text-xs text-slate-200 leading-relaxed font-medium">
                Shareholding documentation requires reconciliation against MCA Form PAS-3 allotment register.
              </p>
            </div>
            <div class="pt-2 border-t border-white/5 flex items-center justify-between text-[11px]">
              <span class="text-slate-400 font-mono text-[10px]">Expert: Company Secretary</span>
              <a href="#reporting" class="text-indigo-400 hover:text-indigo-300 font-semibold">View Finding &rarr;</a>
            </div>
          </div>

          <!-- IP -->
          <div class="p-4 rounded-xl bg-slate-900/90 border border-amber-500/20 flex flex-col justify-between space-y-3">
            <div>
              <div class="flex items-center justify-between text-[10px] font-mono mb-2">
                <span class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-300 font-bold uppercase">IP // HIGH</span>
                <span class="text-slate-500">#IP-02</span>
              </div>
              <p class="text-xs text-slate-200 leading-relaxed font-medium">
                IP assignment documentation requires formal developer covenant addendums for overseas contractors.
              </p>
            </div>
            <div class="pt-2 border-t border-white/5 flex items-center justify-between text-[11px]">
              <span class="text-slate-400 font-mono text-[10px]">Expert: IP Legal Counsel</span>
              <a href="#reporting" class="text-indigo-400 hover:text-indigo-300 font-semibold">View Finding &rarr;</a>
            </div>
          </div>

          <!-- TECHNOLOGY -->
          <div class="p-4 rounded-xl bg-slate-900/90 border border-blue-500/20 flex flex-col justify-between space-y-3">
            <div>
              <div class="flex items-center justify-between text-[10px] font-mono mb-2">
                <span class="px-2 py-0.5 rounded bg-blue-500/10 text-blue-300 font-bold uppercase">TECH // MEDIUM</span>
                <span class="text-slate-500">#T-04</span>
              </div>
              <p class="text-xs text-slate-200 leading-relaxed font-medium">
                Proprietary core SDK relies on deprecated open-source library requiring migration path.
              </p>
            </div>
            <div class="pt-2 border-t border-white/5 flex items-center justify-between text-[11px]">
              <span class="text-slate-400 font-mono text-[10px]">Expert: Tech Architect</span>
              <a href="#reporting" class="text-indigo-400 hover:text-indigo-300 font-semibold">View Finding &rarr;</a>
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- Section 24: DD Control Tower -->
    <div id="control-tower" class="mt-20 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-5 space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-mono uppercase tracking-wider">
          Leadership Visibility
        </div>
        <h3 class="text-2xl sm:text-4xl font-bold text-white font-heading tracking-tight">
          See the entire DD at a glance.
        </h3>
        <p class="text-slate-300 text-sm leading-relaxed">
          LIFT gives transaction leads, fund partners, and corporate M&A heads an unvarnished, live cockpit across all active workstreams, experts, open queries, and upcoming transaction milestones.
        </p>

        <div class="space-y-2 pt-2 text-xs text-slate-300">
          <div class="flex items-center gap-2">
            <span class="text-indigo-400 font-bold">✓</span>
            <span>Live workstream progress tracking across 10 disciplines</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-indigo-400 font-bold">✓</span>
            <span>Real-time risk heatmap with severity breakdown</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-indigo-400 font-bold">✓</span>
            <span>Pending information bottlenecks surfaced automatically</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-indigo-400 font-bold">✓</span>
            <span>Single-click export to investment committee memos</span>
          </div>
        </div>
      </div>

      <!-- Control Tower Matrix Visual -->
      <div class="lg:col-span-7 glass-panel rounded-2xl p-6 border border-white/10 space-y-4">
        <div class="flex justify-between items-center text-xs pb-3 border-b border-white/10">
          <span class="font-semibold text-white">Workstream Progress & Risk Matrix</span>
          <span class="text-[10px] font-mono text-emerald-400">All Streams Synchronised</span>
        </div>

        <div class="space-y-3">
          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-300 font-medium">Financial DD (Controls, P&L, Audit)</span>
              <span class="text-white font-mono">82% • 1 Critical Risk</span>
            </div>
            <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
              <div class="bg-indigo-500 h-full w-[82%]"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-300 font-medium">Tax DD (GST, Income Tax, Assessments)</span>
              <span class="text-white font-mono">78% • Low Risk</span>
            </div>
            <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
              <div class="bg-blue-500 h-full w-[78%]"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-300 font-medium">Corporate & ROC (MCA, Cap Table, Filings)</span>
              <span class="text-white font-mono">90% • 1 High Risk</span>
            </div>
            <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
              <div class="bg-purple-500 h-full w-[90%]"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-300 font-medium">Legal & Material Contracts (Litigation)</span>
              <span class="text-white font-mono">68% • Moderate</span>
            </div>
            <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
              <div class="bg-cyan-500 h-full w-[68%]"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
