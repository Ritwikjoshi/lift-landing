---

<header class="sticky top-0 z-50 w-full border-b border-white/[0.08] bg-[#060913]/75 backdrop-blur-xl transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 via-purple-600 to-blue-500 flex items-center justify-center shadow-[0_0_20px_rgba(99,102,241,0.5)] group-hover:shadow-[0_0_30px_rgba(99,102,241,0.8)] transition-all">
        <span class="font-extrabold text-white text-xl tracking-tighter">L</span>
      </div>
      <div class="flex flex-col">
        <span class="text-xl font-bold tracking-tight text-white flex items-center gap-1.5 font-heading">
          LIFT
          <span class="text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">OS</span>
        </span>
        <span class="text-[10px] tracking-widest uppercase text-slate-400 font-medium -mt-0.5">By GGAM Advisory</span>
      </div>
    </a>

    <!-- Nav Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
      <a href="#portals" class="hover:text-white transition-colors">Portals</a>
      <a href="#simulator" class="hover:text-white transition-colors">DD Engine</a>
      <a href="#workflow" class="hover:text-white transition-colors">Workflow</a>
      <a href="#governance" class="hover:text-white transition-colors">Governance</a>
    </nav>

    <!-- Portal Launch Actions -->
    <div class="flex items-center gap-3">
      <!-- Main CTA Button -->
      <a href="#portals" class="relative inline-flex items-center justify-center p-0.5 overflow-hidden text-xs font-semibold rounded-lg group bg-gradient-to-r from-indigo-500 via-purple-500 to-blue-500 shadow-[0_0_15px_rgba(99,102,241,0.4)] hover:shadow-[0_0_25px_rgba(99,102,241,0.7)] transition-all">
        <span class="px-4 py-2 transition-all ease-in duration-75 bg-[#060913] rounded-[7px] group-hover:bg-transparent text-white">
          Explore Platform
        </span>
      </a>
    </div>
  </div>
</header>
