---
// src/components/Navbar.astro
import Logo from "./Logo.astro";
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200/80 bg-white/80 backdrop-blur-xl transition-all shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="group flex items-center">
      <Logo size={38} />
    </a>

    <!-- Desktop Navigation Links with Dropdowns -->
    <nav class="hidden lg:flex items-center gap-7 text-sm font-medium text-slate-600">
      
      <!-- Platform Dropdown -->
      <div class="relative group py-2">
        <button class="flex items-center gap-1.5 hover:text-slate-900 transition-colors cursor-pointer focus:outline-none">
          <span>Platform</span>
          <svg class="w-3.5 h-3.5 text-slate-500 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none group-hover:pointer-events-auto">
          <div class="w-80 rounded-2xl glass-panel-glow p-3 border border-slate-200/90 shadow-[0_20px_40px_rgba(15,23,42,0.08)] grid grid-cols-1 gap-1 bg-white/95">
            <a href="/#checklist" class="p-2.5 rounded-xl hover:bg-slate-50 transition-colors flex items-start gap-3">
              <span class="p-1.5 rounded-lg bg-violet-500/10 text-violet-700 mt-0.5 text-xs">📋</span>
              <div>
                <div class="text-xs font-semibold text-slate-900">Smart DD Checklist</div>
                <div class="text-[11px] text-slate-500">Structured, reusable request scope</div>
              </div>
            </a>
            <a href="/#dataroom" class="p-2.5 rounded-xl hover:bg-slate-50 transition-colors flex items-start gap-3">
              <span class="p-1.5 rounded-lg bg-blue-500/10 text-blue-700 mt-0.5 text-xs">🗂️</span>
              <div>
                <div class="text-xs font-semibold text-slate-900">Smart Data Room</div>
                <div class="text-[11px] text-slate-500">Connected to diligence parameters</div>
              </div>
            </a>
            <a href="/#experts" class="p-2.5 rounded-xl hover:bg-slate-50 transition-colors flex items-start gap-3">
              <span class="p-1.5 rounded-lg bg-purple-500/10 text-purple-700 mt-0.5 text-xs">⚖️</span>
              <div>
                <div class="text-xs font-semibold text-slate-900">Expert Workspace</div>
                <div class="text-[11px] text-slate-500">Specialist allocation & review hub</div>
              </div>
            </a>
            <a href="/#queryhub" class="p-2.5 rounded-xl hover:bg-slate-50 transition-colors flex items-start gap-3">
              <span class="p-1.5 rounded-lg bg-emerald-500/10 text-emerald-700 mt-0.5 text-xs">💬</span>
              <div>
                <div class="text-xs font-semibold text-slate-900">Central Query Hub</div>
                <div class="text-[11px] text-slate-500">Structured question lifecycles</div>
              </div>
            </a>
            <a href="/#ai-intel" class="p-2.5 rounded-xl hover:bg-slate-50 transition-colors flex items-start gap-3">
              <span class="p-1.5 rounded-lg bg-cyan-500/10 text-cyan-700 mt-0.5 text-xs">⚡</span>
              <div>
                <div class="text-xs font-semibold text-slate-900">AI Document Intelligence</div>
                <div class="text-[11px] text-slate-500">AI-assisted. Expert-verified.</div>
              </div>
            </a>
            <a href="/#flash-dd" class="p-2.5 rounded-xl hover:bg-slate-50 transition-colors flex items-start gap-3">
              <span class="p-1.5 rounded-lg bg-amber-500/10 text-amber-700 mt-0.5 text-xs">🚨</span>
              <div>
                <div class="text-xs font-semibold text-slate-900">Flash DD™ & Risk Radar</div>
                <div class="text-[11px] text-slate-500">Continuous findings as work unfolds</div>
              </div>
            </a>
            <a href="/#control-tower" class="p-2.5 rounded-xl hover:bg-slate-50 transition-colors flex items-start gap-3">
              <span class="p-1.5 rounded-lg bg-rose-500/10 text-rose-700 mt-0.5 text-xs">🗼</span>
              <div>
                <div class="text-xs font-semibold text-slate-900">DD Control Tower</div>
                <div class="text-[11px] text-slate-500">Full visibility for deal leads</div>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- Solutions Dropdown -->
      <div class="relative group py-2">
        <button class="flex items-center gap-1.5 hover:text-slate-900 transition-colors cursor-pointer focus:outline-none">
          <span>Solutions</span>
          <svg class="w-3.5 h-3.5 text-slate-500 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none group-hover:pointer-events-auto">
          <div class="w-72 rounded-2xl glass-panel-glow p-3 border border-slate-200/90 shadow-[0_20px_40px_rgba(15,23,42,0.08)] grid grid-cols-1 gap-1 bg-white/95">
            <a href="/#who-uses-lift" class="p-2 rounded-xl hover:bg-slate-50 transition-colors">
              <div class="text-xs font-semibold text-slate-900">For Investors</div>
              <div class="text-[11px] text-slate-500">PE, VC & Family Offices</div>
            </a>
            <a href="/#who-uses-lift" class="p-2 rounded-xl hover:bg-slate-50 transition-colors">
              <div class="text-xs font-semibold text-slate-900">For Corporates</div>
              <div class="text-[11px] text-slate-500">M&A and Strategy Teams</div>
            </a>
            <a href="/#who-uses-lift" class="p-2 rounded-xl hover:bg-slate-50 transition-colors">
              <div class="text-xs font-semibold text-slate-900">For Founders</div>
              <div class="text-[11px] text-slate-500">Diligence-ready fundraises</div>
            </a>
            <a href="/#who-uses-lift" class="p-2 rounded-xl hover:bg-slate-50 transition-colors">
              <div class="text-xs font-semibold text-slate-900">For Advisors</div>
              <div class="text-[11px] text-slate-500">CA, CS, Legal & Valuers</div>
            </a>
            <a href="/#who-uses-lift" class="p-2 rounded-xl hover:bg-slate-50 transition-colors">
              <div class="text-xs font-semibold text-slate-900">Incubators & Accelerators</div>
              <div class="text-[11px] text-slate-500">Cohort standardisation</div>
            </a>
          </div>
        </div>
      </div>

      <a href="/#workstreams" class="hover:text-slate-900 transition-colors">DD Workstreams</a>
      <a href="/how-it-works" class="hover:text-slate-900 transition-colors">How It Works</a>
      <a href="/about" class="hover:text-slate-900 transition-colors">About</a>
      <a href="/security" class="hover:text-slate-900 transition-colors">Security</a>
    </nav>

    <!-- CTAs -->
    <div class="hidden sm:flex items-center gap-3">
      <a href="/contact?intent=demo" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-xl transition-all active:scale-[0.98]">
        Book a Demo
      </a>

      <a href="/contact?intent=start-dd" class="px-4 py-2 text-xs font-semibold rounded-xl bg-gradient-to-r from-[#8b5cf6] to-[#d946ef] text-white shadow-[0_0_20px_rgba(139,92,246,0.35)] hover:shadow-[0_0_30px_rgba(139,92,246,0.6)] active:scale-[0.98] transition-all flex items-center gap-1.5">
        <span>Start a DD</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <div class="flex lg:hidden items-center gap-2">
      <a href="/contact?intent=start-dd" class="px-3 py-1.5 rounded-lg bg-gradient-to-r from-[#8b5cf6] to-[#d946ef] text-white text-xs font-semibold active:scale-[0.98] shadow-md">
        Start DD
      </a>
      <button id="mobile-menu-toggle" aria-label="Toggle navigation menu" class="p-2 rounded-lg bg-slate-100 border border-slate-200 text-slate-700 hover:text-slate-900 focus:outline-none">
        <svg id="hamburger-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-b border-slate-200 bg-white/95 px-5 py-6 space-y-4">
    <div class="space-y-2">
      <div class="text-[11px] font-bold uppercase tracking-wider text-violet-700">Platform Features</div>
      <div class="grid grid-cols-2 gap-2 text-xs">
        <a href="/#checklist" class="p-2 rounded-lg bg-slate-50 text-slate-700 hover:bg-slate-100">Smart Checklist</a>
        <a href="/#dataroom" class="p-2 rounded-lg bg-slate-50 text-slate-700 hover:bg-slate-100">Data Room</a>
        <a href="/#experts" class="p-2 rounded-lg bg-slate-50 text-slate-700 hover:bg-slate-100">Expert Workspace</a>
        <a href="/#queryhub" class="p-2 rounded-lg bg-slate-50 text-slate-700 hover:bg-slate-100">Query Hub</a>
        <a href="/#flash-dd" class="p-2 rounded-lg bg-slate-50 text-slate-700 hover:bg-slate-100">Flash DD™</a>
        <a href="/#control-tower" class="p-2 rounded-lg bg-slate-50 text-slate-700 hover:bg-slate-100">Control Tower</a>
      </div>
    </div>

    <div class="pt-2 border-t border-slate-200 space-y-2">
      <div class="text-[11px] font-bold uppercase tracking-wider text-violet-700">Navigation</div>
      <a href="/#workstreams" class="block text-sm text-slate-700 py-1 hover:text-slate-900">DD Workstreams</a>
      <a href="/how-it-works" class="block text-sm text-slate-700 py-1 hover:text-slate-900">How It Works</a>
      <a href="/#who-uses-lift" class="block text-sm text-slate-700 py-1 hover:text-slate-900">Solutions by Persona</a>
      <a href="/about" class="block text-sm text-slate-700 py-1 hover:text-slate-900">About LIFT</a>
      <a href="/security" class="block text-sm text-slate-700 py-1 hover:text-slate-900">Security Architecture</a>
    </div>

    <div class="pt-4 border-t border-slate-200 flex flex-col gap-2.5">
      <a href="/contact?intent=start-dd" class="w-full text-center py-2.5 rounded-xl bg-gradient-to-r from-[#8b5cf6] to-[#d946ef] text-white font-semibold text-xs shadow-md active:scale-[0.98]">
        Start a DD
      </a>
      <a href="/contact?intent=demo" class="w-full text-center py-2.5 rounded-xl bg-slate-100 border border-slate-200 text-slate-700 text-xs font-semibold">
        Book a Demo
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (toggleBtn && menu && hamburgerIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      if (isOpen) {
        menu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      } else {
        menu.classList.remove('hidden');
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      }
    });
  }
</script>
