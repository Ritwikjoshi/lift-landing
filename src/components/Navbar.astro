---
---

<header class="sticky top-0 z-50 w-full border-b border-white/[0.08] bg-[#060913]/75 backdrop-blur-xl transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 via-purple-600 to-blue-500 flex items-center justify-center shadow-[0_0_20px_rgba(99,102,241,0.5)] group-hover:shadow-[0_0_30px_rgba(99,102,241,0.8)] transition-all">
        <span class="font-extrabold text-white text-xl tracking-tighter">L</span>
      </div>
      <div class="flex flex-col">
        <span class="text-xl font-bold tracking-tight text-white flex items-center gap-1.5 font-heading">
          LIFT
          <span class="text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">OS</span>
        </span>
        <span class="text-[10px] tracking-widest uppercase text-slate-400 font-medium -mt-0.5">By GGAM Advisory</span>
      </div>
    </a>

    <!-- Nav Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
      <a href="#portals" class="hover:text-white transition-colors">Portals</a>
      <a href="#simulator" class="hover:text-white transition-colors">DD Engine</a>
      <a href="#workflow" class="hover:text-white transition-colors">Workflow</a>
      <a href="#governance" class="hover:text-white transition-colors">Governance</a>
    </nav>

    <!-- Portal Launch Actions -->
    <div class="flex items-center gap-3">
      <!-- Portal Selector Dropdown -->
      <div class="relative group">
        <button type="button" class="px-3.5 py-2 text-xs font-semibold rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/10 flex items-center gap-2 transition-all">
          <span>Login Portals</span>
          <svg class="w-3.5 h-3.5 opacity-60 group-hover:translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="absolute right-0 mt-2 w-56 rounded-xl bg-[#0b101d] border border-white/10 shadow-2xl p-2 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all transform origin-top-right group-hover:scale-100 scale-95 z-50">
          <a href="https://admin.lift.business" target="_blank" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-white/5 transition-colors group/item">
            <span class="w-2 h-2 rounded-full bg-purple-400 shadow-[0_0_8px_rgba(192,132,252,0.8)]"></span>
            <div>
              <div class="text-xs font-semibold text-white group-hover/item:text-purple-300 transition-colors">GGAM Advisory</div>
              <div class="text-[10px] text-slate-400">Institutional Deal Room</div>
            </div>
          </a>
          <a href="https://portal.lift.business" target="_blank" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-white/5 transition-colors group/item">
            <span class="w-2 h-2 rounded-full bg-blue-400 shadow-[0_0_8px_rgba(96,165,250,0.8)]"></span>
            <div>
              <div class="text-xs font-semibold text-white group-hover/item:text-blue-300 transition-colors">Incubator Portal</div>
              <div class="text-[10px] text-slate-400">Cohort & Readiness</div>
            </div>
          </a>
          <a href="https://app.lift.business" target="_blank" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-white/5 transition-colors group/item">
            <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
            <div>
              <div class="text-xs font-semibold text-white group-hover/item:text-emerald-300 transition-colors">Startup Data Room</div>
              <div class="text-[10px] text-slate-400">Founder Document Ingestion</div>
            </div>
          </a>
        </div>
      </div>

      <!-- Main CTA Button -->
      <a href="#portals" class="relative inline-flex items-center justify-center p-0.5 overflow-hidden text-xs font-semibold rounded-lg group bg-gradient-to-r from-indigo-500 via-purple-500 to-blue-500 shadow-[0_0_15px_rgba(99,102,241,0.4)] hover:shadow-[0_0_25px_rgba(99,102,241,0.7)] transition-all">
        <span class="px-4 py-2 transition-all ease-in duration-75 bg-[#060913] rounded-[7px] group-hover:bg-transparent text-white">
          Explore Platform
        </span>
      </a>
    </div>
  </div>
</header>
