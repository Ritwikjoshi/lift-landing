---
// src/components/Navbar.astro
---

<header class="sticky top-0 z-50 w-full border-b border-white/[0.08] bg-[#070913]/85 backdrop-blur-xl transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 via-purple-600 to-blue-500 flex items-center justify-center shadow-[0_0_20px_rgba(99,102,241,0.5)] group-hover:shadow-[0_0_30px_rgba(99,102,241,0.8)] transition-all">
        <span class="font-extrabold text-white text-xl tracking-tighter">L</span>
      </div>
      <div class="flex flex-col">
        <span class="text-xl font-bold tracking-tight text-white flex items-center gap-1.5 font-heading">
          LIFT
          <span class="text-[9px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded-md bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">DD OS</span>
        </span>
        <span class="text-[10px] tracking-widest uppercase text-slate-400 font-medium -mt-0.5">By GGAM Advisory</span>
      </div>
    </a>

    <!-- Desktop Navigation Links with Dropdowns -->
    <nav class="hidden lg:flex items-center gap-7 text-sm font-medium text-slate-300">
      
      <!-- Platform Dropdown -->
      <div class="relative group py-2">
        <button class="flex items-center gap-1.5 hover:text-white transition-colors cursor-pointer focus:outline-none">
          <span>Platform</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none group-hover:pointer-events-auto">
          <div class="w-80 rounded-2xl glass-panel-glow p-3 border border-white/10 shadow-[0_20px_40px_rgba(0,0,0,0.8)] grid grid-cols-1 gap-1">
            <a href="/#checklist" class="p-2.5 rounded-xl hover:bg-white/5 transition-colors flex items-start gap-3">
              <span class="p-1.5 rounded-lg bg-indigo-500/10 text-indigo-400 mt-0.5 text-xs">📋</span>
              <div>
                <div class="text-xs font-semibold text-white">Smart DD Checklist</div>
                <div class="text-[11px] text-slate-400">Structured, reusable request scope</div>
              </div>
            </a>
            <a href="/#dataroom" class="p-2.5 rounded-xl hover:bg-white/5 transition-colors flex items-start gap-3">
              <span class="p-1.5 rounded-lg bg-blue-500/10 text-blue-400 mt-0.5 text-xs">🗂️</span>
              <div>
                <div class="text-xs font-semibold text-white">Smart Data Room</div>
                <div class="text-[11px] text-slate-400">Connected to diligence parameters</div>
              </div>
            </a>
            <a href="/#experts" class="p-2.5 rounded-xl hover:bg-white/5 transition-colors flex items-start gap-3">
              <span class="p-1.5 rounded-lg bg-purple-500/10 text-purple-400 mt-0.5 text-xs">⚖️</span>
              <div>
                <div class="text-xs font-semibold text-white">Expert Workspace</div>
                <div class="text-[11px] text-slate-400">Specialist allocation & review hub</div>
              </div>
            </a>
            <a href="/#queryhub" class="p-2.5 rounded-xl hover:bg-white/5 transition-colors flex items-start gap-3">
              <span class="p-1.5 rounded-lg bg-emerald-500/10 text-emerald-400 mt-0.5 text-xs">💬</span>
              <div>
                <div class="text-xs font-semibold text-white">Central Query Hub</div>
                <div class="text-[11px] text-slate-400">Structured question lifecycles</div>
              </div>
            </a>
            <a href="/#ai-intel" class="p-2.5 rounded-xl hover:bg-white/5 transition-colors flex items-start gap-3">
              <span class="p-1.5 rounded-lg bg-cyan-500/10 text-cyan-400 mt-0.5 text-xs">⚡</span>
              <div>
                <div class="text-xs font-semibold text-white">AI Document Intelligence</div>
                <div class="text-[11px] text-slate-400">AI-assisted. Expert-verified.</div>
              </div>
            </a>
            <a href="/#flash-dd" class="p-2.5 rounded-xl hover:bg-white/5 transition-colors flex items-start gap-3">
              <span class="p-1.5 rounded-lg bg-amber-500/10 text-amber-400 mt-0.5 text-xs">🚨</span>
              <div>
                <div class="text-xs font-semibold text-white">Flash DD™ & Risk Radar</div>
                <div class="text-[11px] text-slate-400">Continuous findings as work unfolds</div>
              </div>
            </a>
            <a href="/#control-tower" class="p-2.5 rounded-xl hover:bg-white/5 transition-colors flex items-start gap-3">
              <span class="p-1.5 rounded-lg bg-rose-500/10 text-rose-400 mt-0.5 text-xs">🗼</span>
              <div>
                <div class="text-xs font-semibold text-white">DD Control Tower</div>
                <div class="text-[11px] text-slate-400">Full visibility for deal leads</div>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- Solutions Dropdown -->
      <div class="relative group py-2">
        <button class="flex items-center gap-1.5 hover:text-white transition-colors cursor-pointer focus:outline-none">
          <span>Solutions</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none group-hover:pointer-events-auto">
          <div class="w-72 rounded-2xl glass-panel-glow p-3 border border-white/10 shadow-[0_20px_40px_rgba(0,0,0,0.8)] grid grid-cols-1 gap-1">
            <a href="/#who-uses-lift" class="p-2 rounded-xl hover:bg-white/5 transition-colors">
              <div class="text-xs font-semibold text-white">For Investors</div>
              <div class="text-[11px] text-slate-400">PE, VC & Family Offices</div>
            </a>
            <a href="/#who-uses-lift" class="p-2 rounded-xl hover:bg-white/5 transition-colors">
              <div class="text-xs font-semibold text-white">For Corporates</div>
              <div class="text-[11px] text-slate-400">M&A and Strategy Teams</div>
            </a>
            <a href="/#who-uses-lift" class="p-2 rounded-xl hover:bg-white/5 transition-colors">
              <div class="text-xs font-semibold text-white">For Founders</div>
              <div class="text-[11px] text-slate-400">Diligence-ready fundraises</div>
            </a>
            <a href="/#who-uses-lift" class="p-2 rounded-xl hover:bg-white/5 transition-colors">
              <div class="text-xs font-semibold text-white">For Advisors</div>
              <div class="text-[11px] text-slate-400">CA, CS, Legal & Valuers</div>
            </a>
            <a href="/#who-uses-lift" class="p-2 rounded-xl hover:bg-white/5 transition-colors">
              <div class="text-xs font-semibold text-white">Incubators & Accelerators</div>
              <div class="text-[11px] text-slate-400">Cohort standardisation</div>
            </a>
          </div>
        </div>
      </div>

      <a href="/#workstreams" class="hover:text-white transition-colors">DD Workstreams</a>
      <a href="/how-it-works" class="hover:text-white transition-colors">How It Works</a>
      <a href="/about" class="hover:text-white transition-colors">About</a>
      <a href="/security" class="hover:text-white transition-colors">Security</a>
    </nav>

    <!-- CTAs -->
    <div class="hidden sm:flex items-center gap-3">
      <a href="/contact?intent=demo" class="px-4 py-2 text-xs font-semibold text-slate-300 hover:text-white transition-colors">
        Book a Demo
      </a>

      <a href="/contact?intent=start-dd" class="relative inline-flex items-center justify-center p-0.5 overflow-hidden text-xs font-semibold rounded-xl group bg-gradient-to-r from-indigo-500 via-purple-500 to-blue-500 shadow-[0_0_20px_rgba(99,102,241,0.4)] hover:shadow-[0_0_30px_rgba(99,102,241,0.7)] transition-all">
        <span class="px-4 py-2 transition-all ease-in duration-75 bg-[#070913] rounded-[10px] group-hover:bg-transparent text-white flex items-center gap-1.5">
          <span>Start a DD</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </span>
      </a>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <div class="flex lg:hidden items-center gap-2">
      <a href="/contact?intent=start-dd" class="px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-xs font-semibold">
        Start DD
      </a>
      <button id="mobile-menu-toggle" aria-label="Toggle navigation menu" class="p-2 rounded-lg bg-white/5 border border-white/10 text-slate-300 hover:text-white focus:outline-none">
        <svg id="hamburger-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-b border-white/10 bg-[#070913] px-5 py-6 space-y-4">
    <div class="space-y-2">
      <div class="text-[11px] font-bold uppercase tracking-wider text-indigo-400">Platform Features</div>
      <div class="grid grid-cols-2 gap-2 text-xs">
        <a href="/#checklist" class="p-2 rounded-lg bg-white/5 text-slate-300">Smart Checklist</a>
        <a href="/#dataroom" class="p-2 rounded-lg bg-white/5 text-slate-300">Data Room</a>
        <a href="/#experts" class="p-2 rounded-lg bg-white/5 text-slate-300">Expert Workspace</a>
        <a href="/#queryhub" class="p-2 rounded-lg bg-white/5 text-slate-300">Query Hub</a>
        <a href="/#flash-dd" class="p-2 rounded-lg bg-white/5 text-slate-300">Flash DD™</a>
        <a href="/#control-tower" class="p-2 rounded-lg bg-white/5 text-slate-300">Control Tower</a>
      </div>
    </div>

    <div class="pt-2 border-t border-white/10 space-y-2">
      <div class="text-[11px] font-bold uppercase tracking-wider text-indigo-400">Navigation</div>
      <a href="/#workstreams" class="block text-sm text-slate-200 py-1">DD Workstreams</a>
      <a href="/how-it-works" class="block text-sm text-slate-200 py-1">How It Works</a>
      <a href="/#who-uses-lift" class="block text-sm text-slate-200 py-1">Solutions by Persona</a>
      <a href="/about" class="block text-sm text-slate-200 py-1">About LIFT</a>
      <a href="/security" class="block text-sm text-slate-200 py-1">Security Architecture</a>
    </div>

    <div class="pt-4 border-t border-white/10 flex flex-col gap-2.5">
      <a href="/contact?intent=start-dd" class="w-full text-center py-2.5 rounded-xl bg-indigo-600 text-white font-semibold text-xs shadow-md">
        Start a DD
      </a>
      <a href="/contact?intent=demo" class="w-full text-center py-2.5 rounded-xl bg-white/5 border border-white/10 text-slate-200 text-xs font-semibold">
        Book a Demo
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (toggleBtn && menu && hamburgerIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      if (isOpen) {
        menu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      } else {
        menu.classList.remove('hidden');
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      }
    });
  }
</script>
