---
---

<section id="portals" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-indigo-400 mb-3">Unified Ecosystem Architecture</h2>
      <p class="text-3xl sm:text-5xl font-bold text-white font-heading tracking-tight">
        Three Dedicated Portals. One Integrated Brain.
      </p>
      <p class="mt-4 text-base sm:text-lg text-slate-300">
        Engineered specifically for each stakeholder in the private investment lifecycle, eliminating email ping-pong and unstructured document chaos.
      </p>
    </div>

    <!-- Bento Grid Container -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- PORTAL 1: GGAM Advisory (Col Span 7) -->
      <div class="lg:col-span-7 glass-panel-glow rounded-3xl p-8 sm:p-10 border border-purple-500/20 relative overflow-hidden group flex flex-col justify-between">
        <div class="absolute -right-16 -top-16 w-64 h-64 bg-purple-600/15 rounded-full blur-3xl pointer-events-none group-hover:bg-purple-600/25 transition-all duration-700"></div>

        <div>
          <!-- Portal Tag & Badge -->
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3">
              <span class="w-3 h-3 rounded-full bg-purple-400 shadow-[0_0_10px_rgba(192,132,252,1)]"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-purple-300 font-heading">Portal 01</span>
            </div>
            <span class="text-[11px] font-semibold px-3 py-1 rounded-full bg-purple-500/10 text-purple-300 border border-purple-500/20">
              Institutional Master Control
            </span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-bold text-white font-heading">
            GGAM Advisory Command Centre
          </h3>
          <p class="mt-3 text-slate-300 text-sm sm:text-base leading-relaxed">
            The master terminal for due diligence analysts, investment committees, and portfolio leads. Ingest unlimited venture dossiers, oversee multi-incubator syndicates, and generate audit-ready IC memos.
          </p>

          <!-- Core Feature Bullets -->
          <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-4 rounded-xl bg-slate-900/60 border border-white/5">
              <div class="text-purple-300 font-semibold text-sm mb-1">Portfolio Risk Matrix</div>
              <p class="text-xs text-slate-400">Automated multi-deal risk scoring with cross-portfolio litigation and compliance scans.</p>
            </div>
            <div class="p-4 rounded-xl bg-slate-900/60 border border-white/5">
              <div class="text-purple-300 font-semibold text-sm mb-1">Audit-Ready IC Memo</div>
              <p class="text-xs text-slate-400">Export structured due diligence verdicts, red-flags, and remediation conditions in one click.</p>
            </div>
            <div class="p-4 rounded-xl bg-slate-900/60 border border-white/5">
              <div class="text-purple-300 font-semibold text-sm mb-1">Direct Deal Syndication</div>
              <p class="text-xs text-slate-400">Collaborate synchronously with incubator directors and founders in encrypted rooms.</p>
            </div>
            <div class="p-4 rounded-xl bg-slate-900/60 border border-white/5">
              <div class="text-purple-300 font-semibold text-sm mb-1">Granular Role Governance</div>
              <p class="text-xs text-slate-400">Strict isolation between Advisory Analysts, Partners, and External Legal Counsels.</p>
            </div>
          </div>
        </div>

        <!-- Launch Button -->
        <div class="mt-8 pt-6 border-t border-white/10 flex items-center justify-between">
          <span class="text-xs font-mono text-purple-300">admin.lift.business</span>
          <a href="https://admin.lift.business" target="_blank" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-semibold text-xs transition-all shadow-[0_0_20px_rgba(168,85,247,0.4)]">
            <span>Launch GGAM Portal</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

      <!-- PORTAL 2: Incubator Ecosystem (Col Span 5) -->
      <div class="lg:col-span-5 glass-panel-glow rounded-3xl p-8 sm:p-10 border border-blue-500/20 relative overflow-hidden group flex flex-col justify-between">
        <div class="absolute -right-16 -top-16 w-64 h-64 bg-blue-600/15 rounded-full blur-3xl pointer-events-none group-hover:bg-blue-600/25 transition-all duration-700"></div>

        <div>
          <!-- Tag & Badge -->
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3">
              <span class="w-3 h-3 rounded-full bg-blue-400 shadow-[0_0_10px_rgba(96,165,250,1)]"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-blue-300 font-heading">Portal 02</span>
            </div>
            <span class="text-[11px] font-semibold px-3 py-1 rounded-full bg-blue-500/10 text-blue-300 border border-blue-500/20">
              Cohort Enabler
            </span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-bold text-white font-heading">
            Incubator Cohort Hub
          </h3>
          <p class="mt-3 text-slate-300 text-sm leading-relaxed">
            Built for startup hubs, accelerators, and institutions (e.g. T-Hub, iCreate, BIRAC) to monitor cohort diligence readiness and fast-track venture capital syndication.
          </p>

          <div class="mt-8 space-y-4">
            <div class="p-3.5 rounded-xl bg-slate-900/60 border border-white/5 flex items-start gap-3">
              <div class="p-2 rounded-lg bg-blue-500/10 text-blue-400 mt-0.5">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
              </div>
              <div>
                <div class="text-white font-semibold text-xs">Real-Time Cohort Pipeline</div>
                <div class="text-[11px] text-slate-400 mt-0.5">Live tracking of 50+ startups progressing from seed checklist to investor readiness.</div>
              </div>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-900/60 border border-white/5 flex items-start gap-3">
              <div class="p-2 rounded-lg bg-blue-500/10 text-blue-400 mt-0.5">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <div class="text-white font-semibold text-xs">Government Scheme Alignment</div>
                <div class="text-[11px] text-slate-400 mt-0.5">Automated validation against Startup India Seed Fund and grant benchmarks.</div>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-white/10 flex items-center justify-between">
          <span class="text-xs font-mono text-blue-300">portal.lift.business</span>
          <a href="https://portal.lift.business" target="_blank" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs transition-all shadow-[0_0_20px_rgba(37,99,235,0.4)]">
            <span>Launch Incubator</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

      <!-- PORTAL 3: Startup Data Room (Col Span 12) -->
      <div class="lg:col-span-12 glass-panel-glow rounded-3xl p-8 sm:p-10 border border-emerald-500/20 relative overflow-hidden group">
        <div class="absolute -right-16 -top-16 w-80 h-80 bg-emerald-600/10 rounded-full blur-3xl pointer-events-none group-hover:bg-emerald-600/20 transition-all duration-700"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7">
            <!-- Tag & Badge -->
            <div class="flex items-center gap-3 mb-6">
              <span class="w-3 h-3 rounded-full bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,1)]"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-emerald-300 font-heading">Portal 03</span>
              <span class="text-[11px] font-semibold px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">
                Founder Frictionless Data Room
              </span>
            </div>

            <h3 class="text-2xl sm:text-4xl font-bold text-white font-heading">
              Startup Virtual Data Room & Diligence Engine
            </h3>
            <p class="mt-4 text-slate-300 text-base sm:text-lg leading-relaxed">
              No more messy Google Drive links or missing schedules. Founders upload once; our engine automatically categorizes files, matches checklists, resolves queries, and displays real-time readiness feedback.
            </p>

            <div class="mt-6 flex flex-wrap gap-3">
              <span class="px-3.5 py-1.5 rounded-lg bg-slate-900 border border-white/5 text-xs text-slate-300 flex items-center gap-2">
                <span class="text-emerald-400 font-bold">✓</span> Automated Document Tagging
              </span>
              <span class="px-3.5 py-1.5 rounded-lg bg-slate-900 border border-white/5 text-xs text-slate-300 flex items-center gap-2">
                <span class="text-emerald-400 font-bold">✓</span> Instant Query Resolution Trail
              </span>
              <span class="px-3.5 py-1.5 rounded-lg bg-slate-900 border border-white/5 text-xs text-slate-300 flex items-center gap-2">
                <span class="text-emerald-400 font-bold">✓</span> Watermarked Secure Viewer
              </span>
              <span class="px-3.5 py-1.5 rounded-lg bg-slate-900 border border-white/5 text-xs text-slate-300 flex items-center gap-2">
                <span class="text-emerald-400 font-bold">✓</span> Zero Data Leakage Architecture
              </span>
            </div>
          </div>

          <div class="lg:col-span-5 bg-slate-900/80 rounded-2xl p-6 border border-white/10 flex flex-col justify-between">
            <div class="space-y-4">
              <div class="flex items-center justify-between text-xs pb-3 border-b border-white/10">
                <span class="text-slate-400 font-mono">ENCRYPTED REPOSITORY</span>
                <span class="text-emerald-400 font-mono">STATUS: SYNCHRONIZED</span>
              </div>
              <div class="space-y-2.5">
                <div class="flex justify-between text-xs p-2.5 rounded-lg bg-white/5">
                  <span class="text-white">Audited Financial Statements (3 Yrs)</span>
                  <span class="text-emerald-400 font-medium font-mono">Verified</span>
                </div>
                <div class="flex justify-between text-xs p-2.5 rounded-lg bg-white/5">
                  <span class="text-white">Fully Diluted Cap Table (Shares & ESOP)</span>
                  <span class="text-emerald-400 font-medium font-mono">Verified</span>
                </div>
                <div class="flex justify-between text-xs p-2.5 rounded-lg bg-white/5">
                  <span class="text-white">IP Assignment & Trademark Filings</span>
                  <span class="text-indigo-400 font-medium font-mono">In Review</span>
                </div>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between">
              <span class="text-xs font-mono text-emerald-300">app.lift.business</span>
              <a href="https://app.lift.business" target="_blank" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs transition-all shadow-[0_0_20px_rgba(16,185,129,0.4)]">
                <span>Enter Startup Portal</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
