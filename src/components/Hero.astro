---
// src/components/Hero.astro
---

<section class="relative pt-20 pb-20 md:pt-32 md:pb-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Eyebrow Tag -->
    <div class="flex justify-center mb-8">
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-violet-50 border border-violet-200/80 text-xs font-semibold tracking-wider uppercase text-violet-700 shadow-xs">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-violet-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-violet-600"></span>
        </span>
        <span>SMART DUE DILIGENCE PLATFORM</span>
      </div>
    </div>

    <!-- Editorial Headline -->
    <div class="text-center max-w-4xl mx-auto">
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-slate-900 font-heading leading-[1.15]">
        Smart Due Diligence.
        <span class="block mt-2 bg-gradient-to-r from-violet-600 via-fuchsia-600 to-indigo-600 bg-clip-text text-transparent">
          Accelerated.
        </span>
      </h1>
      
      <p class="mt-6 text-base sm:text-xl text-slate-600 font-normal max-w-3xl mx-auto leading-relaxed">
        LIFT brings your DD checklist, data room, experts, queries, risks and reporting into one connected workflow—helping teams reduce coordination, surface findings earlier and move from information to decision faster.
      </p>

      <!-- CTA Row -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact?intent=start-dd" class="w-full sm:w-auto px-8 py-4 rounded-xl font-semibold text-sm bg-gradient-to-r from-[#8b5cf6] to-[#d946ef] text-white shadow-[0_0_30px_rgba(139,92,246,0.35)] hover:shadow-[0_0_45px_rgba(139,92,246,0.6)] hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2">
          <span>Start a DD</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <a href="/contact?intent=demo" class="w-full sm:w-auto px-8 py-4 rounded-xl font-semibold text-sm glass-card border border-slate-200/90 hover:border-slate-300 text-slate-700 hover:text-slate-900 hover:bg-slate-50 active:scale-[0.98] transition-all flex items-center justify-center gap-2 shadow-xs">
          <span>Book a Demo</span>
          <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </a>
      </div>

      <p class="mt-4 text-xs text-slate-500">
        Built for investors, corporates, founders and professional advisors.
      </p>
    </div>

    <!-- Section 10: Hero Visual — Interactive Product Animation Flow -->
    <div class="mt-14 max-w-5xl mx-auto">
      <div class="relative rounded-3xl glass-panel p-4 sm:p-7 border border-slate-200/90 shadow-[0_20px_50px_rgba(15,23,42,0.06)] bg-white/80">
        
        <!-- Window Mock Topbar -->
        <div class="flex items-center justify-between pb-4 border-b border-slate-200/80 text-xs text-slate-500">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-400 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-amber-400 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-400 inline-block"></span>
            <span class="ml-2 text-[11px] font-mono text-slate-500">lift.business // dd-operating-canvas</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-[11px] font-mono text-emerald-700 font-medium">CONNECTED WORKFLOW ACTIVE</span>
          </div>
        </div>

        <!-- Visual Flow Strip: Checklist -> Documents -> Experts -> Queries -> Findings -> Flash DD -> Decision -->
        <div class="mt-6 mb-6">
          <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-3 flex items-center justify-between">
            <span>Diligence Value Chain (Live Progression)</span>
            <span class="text-violet-700 font-mono text-[10px] bg-violet-50 px-2 py-0.5 rounded border border-violet-100">7 Connected Nodes</span>
          </div>

          <!-- Process nodes horizontal flow -->
          <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2.5 text-center">
            
            <div class="p-3 rounded-xl bg-white border border-slate-200/80 shadow-xs relative group">
              <div class="text-[10px] font-mono text-violet-600 mb-1 font-semibold">01. SCOPE</div>
              <div class="text-xs font-semibold text-slate-900">DD Checklist</div>
              <div class="text-[10px] text-slate-500 mt-1">Structured templates</div>
            </div>

            <div class="p-3 rounded-xl bg-white border border-slate-200/80 shadow-xs relative group">
              <div class="text-[10px] font-mono text-blue-600 mb-1 font-semibold">02. REPOSITORY</div>
              <div class="text-xs font-semibold text-slate-900">Documents</div>
              <div class="text-[10px] text-slate-500 mt-1">Mapped data room</div>
            </div>

            <div class="p-3 rounded-xl bg-white border border-slate-200/80 shadow-xs relative group">
              <div class="text-[10px] font-mono text-purple-600 mb-1 font-semibold">03. TALENT</div>
              <div class="text-xs font-semibold text-slate-900">Experts</div>
              <div class="text-[10px] text-slate-500 mt-1">Multi-domain CA/CS/Law</div>
            </div>

            <div class="p-3 rounded-xl bg-white border border-slate-200/80 shadow-xs relative group">
              <div class="text-[10px] font-mono text-cyan-600 mb-1 font-semibold">04. DIALOGUE</div>
              <div class="text-xs font-semibold text-slate-900">Queries</div>
              <div class="text-[10px] text-slate-500 mt-1">Tracked conversations</div>
            </div>

            <div class="p-3 rounded-xl bg-white border border-slate-200/80 shadow-xs relative group">
              <div class="text-[10px] font-mono text-amber-600 mb-1 font-semibold">05. EVIDENCE</div>
              <div class="text-xs font-semibold text-slate-900">Findings</div>
              <div class="text-[10px] text-slate-500 mt-1">Prioritised risks</div>
            </div>

            <div class="p-3 rounded-xl bg-white border border-slate-200/80 shadow-xs relative group">
              <div class="text-[10px] font-mono text-rose-600 mb-1 font-semibold">06. RADAR</div>
              <div class="text-xs font-semibold text-slate-900">Flash DD™</div>
              <div class="text-[10px] text-slate-500 mt-1">Evolving insights</div>
            </div>

            <div class="p-3 rounded-xl bg-emerald-50/60 border border-emerald-200 col-span-2 sm:col-span-2 lg:col-span-1 shadow-xs">
              <div class="text-[10px] font-mono text-emerald-700 mb-1 font-semibold">07. GOAL</div>
              <div class="text-xs font-semibold text-emerald-900">Decision</div>
              <div class="text-[10px] text-emerald-700/80 mt-1">IC-ready dossier</div>
            </div>

          </div>
        </div>

        <!-- Interactive Live DD Workspace Mockup -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 pt-4 border-t border-slate-200/80">
          
          <!-- Left: Target Overview (Col 4) -->
          <div class="lg:col-span-4 bg-white/95 rounded-2xl p-4 border border-slate-200/80 shadow-xs flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-500 font-mono">Diligence File</span>
                <span class="text-[10px] px-2 py-0.5 rounded-full bg-violet-50 text-violet-700 border border-violet-200 font-mono font-medium">Series A DD</span>
              </div>
              <div class="text-base font-bold text-slate-900">TechFlow Robotics Pvt. Ltd.</div>
              <div class="text-xs text-slate-500 mt-0.5">Manufacturing & Industrial Robotics Automation</div>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 space-y-3">
              <div>
                <div class="flex justify-between text-xs mb-1">
                  <span class="text-slate-500">DD Progress:</span>
                  <span class="text-slate-900 font-mono font-bold">72% Completed</span>
                </div>
                <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                  <div class="bg-gradient-to-r from-violet-500 to-fuchsia-500 h-full w-[72%] rounded-full"></div>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-2 text-[11px] pt-1">
                <div class="p-2 rounded-lg bg-slate-50 border border-slate-100">
                  <span class="text-slate-500 block text-[10px]">Verified Files</span>
                  <span class="text-slate-900 font-semibold font-mono">184 / 230</span>
                </div>
                <div class="p-2 rounded-lg bg-amber-50/50 border border-amber-100">
                  <span class="text-slate-500 block text-[10px]">Open Queries</span>
                  <span class="text-amber-700 font-semibold font-mono">23 Pending</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Center: Multi-Domain Workstreams (Col 5) -->
          <div class="lg:col-span-5 bg-white/95 rounded-2xl p-4 border border-slate-200/80 shadow-xs space-y-3">
            <div class="flex justify-between items-center pb-2 border-b border-slate-100 text-xs">
              <span class="font-semibold text-slate-700 uppercase tracking-wider text-[10px]">Active Workstreams</span>
              <span class="text-[10px] text-slate-500 font-mono">Assigned Experts</span>
            </div>

            <div class="space-y-2 text-xs">
              <div class="flex items-center justify-between p-2 rounded-xl bg-slate-50 border border-slate-100">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span class="text-slate-800 font-medium">Financial DD (P&L, Audit, Controls)</span>
                </div>
                <span class="text-xs text-slate-900 font-mono font-semibold">82%</span>
              </div>

              <div class="flex items-center justify-between p-2 rounded-xl bg-slate-50 border border-slate-100">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-purple-500"></span>
                  <span class="text-slate-800 font-medium">Corporate & ROC (MCA, Cap Table)</span>
                </div>
                <span class="text-xs text-slate-900 font-mono font-semibold">90%</span>
              </div>

              <div class="flex items-center justify-between p-2 rounded-xl bg-slate-50 border border-slate-100">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                  <span class="text-slate-800 font-medium">Legal DD (Contracts, Litigation)</span>
                </div>
                <span class="text-xs text-slate-900 font-mono font-semibold">68%</span>
              </div>

              <div class="flex items-center justify-between p-2 rounded-xl bg-slate-50 border border-slate-100">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
                  <span class="text-slate-800 font-medium">Tech & Architecture (Stack, Scalability)</span>
                </div>
                <span class="text-xs text-slate-900 font-mono font-semibold">74%</span>
              </div>
            </div>
          </div>

          <!-- Right: Flash Risk Summary (Col 3) -->
          <div class="lg:col-span-3 bg-white/95 rounded-2xl p-4 border border-slate-200/80 shadow-xs flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-500 font-mono">Risk Register</span>
                <span class="text-[10px] text-rose-600 font-mono font-semibold">04 Critical</span>
              </div>

              <div class="space-y-2">
                <div class="p-2.5 rounded-xl bg-rose-50 border border-rose-200/60 text-[11px]">
                  <div class="text-rose-800 font-semibold">Customer Concentration</div>
                  <div class="text-slate-600 text-[10px] mt-0.5">Top customer accounts for 54% of FY25 revenue.</div>
                </div>
                <div class="p-2.5 rounded-xl bg-amber-50 border border-amber-200/60 text-[11px]">
                  <div class="text-amber-800 font-semibold">IP Assignment Covenant</div>
                  <div class="text-slate-600 text-[10px] mt-0.5">Founder patent transfer requires deed confirmation.</div>
                </div>
              </div>
            </div>

            <div class="pt-3 mt-3 border-t border-slate-100 text-center">
              <a href="#flash-dd" class="text-[11px] text-violet-700 hover:text-violet-900 inline-flex items-center gap-1 font-semibold transition-colors">
                <span>Inspect Flash DD™ Dashboard</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>
