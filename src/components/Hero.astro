---
---

<section class="relative pt-24 pb-20 md:pt-36 md:pb-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Top Announcement Pill -->
    <div class="flex justify-center mb-8">
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full glass-panel border border-indigo-500/20 text-xs font-medium text-indigo-300 hover:border-indigo-500/40 transition-all shadow-[0_0_20px_rgba(99,102,241,0.15)] cursor-default">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
        </span>
        <span>Institutional-Grade AI Due Diligence Operating System</span>
        <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>

    <!-- Main Headline -->
    <div class="text-center max-w-4xl mx-auto">
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-white font-heading leading-[1.1]">
        Institutional Due Diligence.
        <span class="block mt-2 bg-gradient-to-r from-indigo-300 via-purple-300 to-blue-300 bg-clip-text text-transparent">
          Accelerated by Intelligence.
        </span>
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-slate-300 font-normal max-w-2xl mx-auto leading-relaxed">
        The unified operating platform connecting <span class="text-white font-medium">GGAM Capital</span>, <span class="text-white font-medium">Premier Incubators</span>, and <span class="text-white font-medium">Breakthrough Ventures</span> with automated risk scoring and airtight auditability.
      </p>

      <!-- CTA Action Row -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#portals" class="w-full sm:w-auto px-8 py-4 rounded-xl font-semibold text-sm bg-gradient-to-r from-indigo-600 via-purple-600 to-blue-600 text-white shadow-[0_0_30px_rgba(99,102,241,0.5)] hover:shadow-[0_0_45px_rgba(99,102,241,0.8)] hover:scale-[1.02] transition-all flex items-center justify-center gap-2">
          <span>Launch Platform Portals</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a href="#simulator" class="w-full sm:w-auto px-8 py-4 rounded-xl font-semibold text-sm glass-panel border border-white/10 hover:border-white/20 text-slate-200 hover:text-white hover:bg-white/5 transition-all flex items-center justify-center gap-2">
          <span>Simulate Due Diligence Score</span>
          <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </a>
      </div>

      <!-- Trust Metrics Bar -->
      <div class="mt-16 pt-10 border-t border-white/[0.06] grid grid-cols-2 md:grid-cols-4 gap-8">
        <div>
          <div class="text-2xl sm:text-3xl font-bold text-white font-heading tracking-tight">₹450Cr+</div>
          <div class="text-xs font-medium text-slate-400 mt-1 uppercase tracking-wider">Pipeline Under Review</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-bold text-indigo-400 font-heading tracking-tight">94%</div>
          <div class="text-xs font-medium text-slate-400 mt-1 uppercase tracking-wider">Faster Time-to-DD</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-bold text-purple-400 font-heading tracking-tight">50+</div>
          <div class="text-xs font-medium text-slate-400 mt-1 uppercase tracking-wider">Automated Checkpoints</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-bold text-emerald-400 font-heading tracking-tight">100%</div>
          <div class="text-xs font-medium text-slate-400 mt-1 uppercase tracking-wider">Institutional Audit Trail</div>
        </div>
      </div>
    </div>

    <!-- Visual Dashboard Sneak Peek Graphic -->
    <div class="mt-16 max-w-5xl mx-auto">
      <div class="relative rounded-2xl glass-panel-glow p-2.5 sm:p-4 shadow-[0_0_50px_rgba(0,0,0,0.8)] border border-indigo-500/20">
        <!-- Mock Browser Header -->
        <div class="flex items-center justify-between px-3 py-2 border-b border-white/10 mb-4 text-xs text-slate-400">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
          </div>
          <div class="bg-black/40 px-6 py-1 rounded-md text-[11px] text-slate-400 border border-white/5 font-mono">
            lift.business // multi-portal-ecosystem
          </div>
          <div class="text-indigo-400 font-mono text-[10px]">LIVE ENCRYPTED</div>
        </div>

        <!-- Dashboard Internal Grid Preview -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 p-2">
          <!-- Left: Target Profile & Score -->
          <div class="md:col-span-4 bg-slate-900/80 rounded-xl p-5 border border-white/5 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Target Enterprise</span>
                <span class="text-[10px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded-full">Phase: Legal Review</span>
              </div>
              <h3 class="text-lg font-bold text-white font-heading">TechFlow Robotics Pvt Ltd</h3>
              <p class="text-xs text-slate-400 mt-1">Autonomous warehouse fulfillment hardware & software.</p>
            </div>

            <div class="mt-6 pt-6 border-t border-white/10">
              <div class="flex items-end justify-between mb-2">
                <span class="text-xs text-slate-400">Overall Diligence Index</span>
                <span class="text-2xl font-bold text-indigo-400 font-heading">88 / 100</span>
              </div>
              <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
                <div class="bg-gradient-to-r from-indigo-500 to-purple-500 h-full w-[88%] rounded-full"></div>
              </div>
              <div class="mt-3 flex items-center justify-between text-[11px] text-slate-400">
                <span>Verified Docs: 38/42</span>
                <span class="text-emerald-400">Low Risk Profile</span>
              </div>
            </div>
          </div>

          <!-- Middle: Pillar Breakdown -->
          <div class="md:col-span-5 bg-slate-900/80 rounded-xl p-5 border border-white/5 space-y-4">
            <div class="flex justify-between items-center mb-1">
              <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Diligence Pillars</span>
              <span class="text-[10px] text-indigo-400">Auto-Validated</span>
            </div>

            <div class="space-y-3">
              <div>
                <div class="flex justify-between text-xs mb-1">
                  <span class="text-slate-300">Financial Integrity (P&L, Balance Sheet, GST)</span>
                  <span class="text-white font-mono font-medium">94%</span>
                </div>
                <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
                  <div class="bg-indigo-500 h-full w-[94%]"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-xs mb-1">
                  <span class="text-slate-300">Corporate & Shareholding (Cap Table, MCA)</span>
                  <span class="text-white font-mono font-medium">90%</span>
                </div>
                <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
                  <div class="bg-purple-500 h-full w-[90%]"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-xs mb-1">
                  <span class="text-slate-300">Intellectual Property & Patents</span>
                  <span class="text-white font-mono font-medium">82%</span>
                </div>
                <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
                  <div class="bg-blue-500 h-full w-[82%]"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-xs mb-1">
                  <span class="text-slate-300">Material Contracts & Litigation Scans</span>
                  <span class="text-white font-mono font-medium">78%</span>
                </div>
                <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
                  <div class="bg-amber-500 h-full w-[78%]"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: Live AI Flag Detection -->
          <div class="md:col-span-3 bg-slate-900/80 rounded-xl p-5 border border-white/5 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">AI Flag Stream</span>
                <span class="flex h-2 w-2 rounded-full bg-emerald-400"></span>
              </div>
              <div class="space-y-3">
                <div class="p-2.5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-[11px]">
                  <div class="text-emerald-300 font-semibold">MCA Filings Reconciled</div>
                  <div class="text-slate-400 mt-0.5 text-[10px]">Zero share capital discrepancy detected.</div>
                </div>
                <div class="p-2.5 rounded-lg bg-amber-500/10 border border-amber-500/20 text-[11px]">
                  <div class="text-amber-300 font-semibold">Non-Compete Clause Ambiguity</div>
                  <div class="text-slate-400 mt-0.5 text-[10px]">Vendor SLA §4.2 requires advisory addendum.</div>
                </div>
              </div>
            </div>

            <div class="mt-4 pt-3 border-t border-white/10 text-center">
              <span class="text-[11px] text-slate-400 hover:text-white cursor-pointer transition-colors">
                View Full Audit Certificate &rarr;
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
