---
// src/components/Hero.astro
---

<section class="relative pt-20 pb-20 md:pt-32 md:pb-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Eyebrow Tag -->
    <div class="flex justify-center mb-8">
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-violet-50 border border-violet-200/80 text-xs font-semibold tracking-wider uppercase text-violet-700 shadow-xs">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-violet-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-violet-600"></span>
        </span>
        <span>SMART DUE DILIGENCE PLATFORM</span>
      </div>
    </div>

    <!-- Editorial Headline -->
    <div class="text-center max-w-4xl mx-auto">
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-slate-900 font-heading leading-[1.15]">
        Smart Due Diligence.
        <span class="block mt-2 bg-gradient-to-r from-violet-600 via-fuchsia-600 to-indigo-600 bg-clip-text text-transparent">
          Accelerated.
        </span>
      </h1>
      
      <p class="mt-6 text-base sm:text-xl text-slate-600 font-normal max-w-3xl mx-auto leading-relaxed">
        LIFT brings your DD checklist, data room, experts, queries, risks and reporting into one connected workflow—helping teams reduce coordination, surface findings earlier and move from information to decision faster.
      </p>

      <!-- CTA Row -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact?intent=start-dd" class="w-full sm:w-auto px-8 py-4 rounded-xl font-semibold text-sm bg-gradient-to-r from-[#8b5cf6] to-[#d946ef] text-white shadow-[0_0_30px_rgba(139,92,246,0.35)] hover:shadow-[0_0_45px_rgba(139,92,246,0.6)] hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2">
          <span>Start a DD</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <a href="/contact?intent=demo" class="w-full sm:w-auto px-8 py-4 rounded-xl font-semibold text-sm glass-card border border-slate-200/90 hover:border-slate-300 text-slate-700 hover:text-slate-900 hover:bg-slate-50 active:scale-[0.98] transition-all flex items-center justify-center gap-2 shadow-xs">
          <span>Book a Demo</span>
          <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </a>
      </div>

      <p class="mt-4 text-xs text-slate-500">
        Built for investors, corporates, founders and professional advisors.
      </p>
    </div>

    <!-- Section 10: Hero Visual — Subtle Operating Canvas -->
    <div class="mt-14 max-w-5xl mx-auto">
      <div class="relative rounded-[28px] bg-gradient-to-b from-white/95 via-white/85 to-slate-50/80 backdrop-blur-2xl p-5 sm:p-8 ring-1 ring-slate-900/[0.06] shadow-[0_32px_80px_-20px_rgba(139,92,246,0.10),0_20px_40px_-15px_rgba(15,23,42,0.05)] overflow-hidden">
        
        <!-- Ambient Radial Glows within Canvas -->
        <div class="absolute -top-24 -left-24 w-72 h-72 bg-violet-400/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-blue-400/10 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Window Mock Topbar (Subtle & Clean) -->
        <div class="relative flex flex-col sm:flex-row sm:items-center justify-between pb-5 gap-3">
          <div class="flex items-center gap-3">
            <!-- Window dots -->
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-slate-300/80 inline-block"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-slate-300/80 inline-block"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-slate-300/80 inline-block"></span>
            </div>
            
            <!-- Address Pill -->
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100/80 text-[11px] font-mono text-slate-600">
              <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              <span>lift.business // dd-operating-canvas</span>
            </div>
          </div>

          <div class="flex items-center gap-2 text-xs">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="text-[11px] font-mono text-emerald-800 font-semibold tracking-wide">CONNECTED WORKFLOW ACTIVE</span>
          </div>
        </div>

        <!-- Hairline Subtle Separator -->
        <div class="h-px w-full bg-gradient-to-r from-transparent via-slate-200/70 to-transparent mb-6"></div>

        <!-- Visual Flow Strip: Subtle Connected Ribbon (No Hard Boxes) -->
        <div class="mb-8">
          <div class="flex items-center justify-between mb-3 text-[11px] text-slate-500 font-medium">
            <span class="uppercase tracking-wider font-semibold text-slate-600">Diligence Value Chain</span>
            <span class="text-violet-700 font-mono text-[10px] bg-violet-50/80 px-2.5 py-0.5 rounded-full">7 Connected Stages</span>
          </div>

          <!-- Seamless Horizontal Track -->
          <div class="bg-slate-100/50 rounded-2xl p-1.5 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-1">
            
            <div class="py-2.5 px-3 rounded-xl hover:bg-white/90 hover:shadow-xs transition-all duration-200 text-center group cursor-default">
              <div class="text-[10px] font-mono text-violet-600 font-bold">01. SCOPE</div>
              <div class="text-xs font-semibold text-slate-900 mt-0.5">Checklist</div>
              <div class="text-[10px] text-slate-500 mt-0.5">Structured</div>
            </div>

            <div class="py-2.5 px-3 rounded-xl hover:bg-white/90 hover:shadow-xs transition-all duration-200 text-center group cursor-default">
              <div class="text-[10px] font-mono text-blue-600 font-bold">02. REPO</div>
              <div class="text-xs font-semibold text-slate-900 mt-0.5">Data Room</div>
              <div class="text-[10px] text-slate-500 mt-0.5">Mapped files</div>
            </div>

            <div class="py-2.5 px-3 rounded-xl hover:bg-white/90 hover:shadow-xs transition-all duration-200 text-center group cursor-default">
              <div class="text-[10px] font-mono text-purple-600 font-bold">03. TALENT</div>
              <div class="text-xs font-semibold text-slate-900 mt-0.5">Experts</div>
              <div class="text-[10px] text-slate-500 mt-0.5">CA / CS / Law</div>
            </div>

            <div class="py-2.5 px-3 rounded-xl hover:bg-white/90 hover:shadow-xs transition-all duration-200 text-center group cursor-default">
              <div class="text-[10px] font-mono text-cyan-600 font-bold">04. DIALOGUE</div>
              <div class="text-xs font-semibold text-slate-900 mt-0.5">Queries</div>
              <div class="text-[10px] text-slate-500 mt-0.5">Tracked Q&A</div>
            </div>

            <div class="py-2.5 px-3 rounded-xl hover:bg-white/90 hover:shadow-xs transition-all duration-200 text-center group cursor-default">
              <div class="text-[10px] font-mono text-amber-600 font-bold">05. EVIDENCE</div>
              <div class="text-xs font-semibold text-slate-900 mt-0.5">Findings</div>
              <div class="text-[10px] text-slate-500 mt-0.5">Triaged risks</div>
            </div>

            <div class="py-2.5 px-3 rounded-xl hover:bg-white/90 hover:shadow-xs transition-all duration-200 text-center group cursor-default">
              <div class="text-[10px] font-mono text-rose-600 font-bold">06. RADAR</div>
              <div class="text-xs font-semibold text-slate-900 mt-0.5">Flash DD™</div>
              <div class="text-[10px] text-slate-500 mt-0.5">Live insights</div>
            </div>

            <div class="py-2.5 px-3 rounded-xl bg-emerald-50/80 col-span-2 sm:col-span-2 lg:col-span-1 text-center group cursor-default">
              <div class="text-[10px] font-mono text-emerald-700 font-bold">07. GOAL</div>
              <div class="text-xs font-semibold text-emerald-950 mt-0.5">Decision</div>
              <div class="text-[10px] text-emerald-700/90 mt-0.5">IC-ready dossier</div>
            </div>

          </div>
        </div>

        <!-- Interactive Live DD Workspace Area — Subtle & Open-Canvas -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 pt-2">
          
          <!-- Left: Target Overview (Col 4) — Clean, Breathing Typography -->
          <div class="lg:col-span-4 flex flex-col justify-between space-y-5">
            <div>
              <div class="flex items-center gap-2 mb-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-violet-600"></span>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-500 font-mono">Diligence Dossier</span>
                <span class="ml-auto text-[10px] px-2 py-0.5 rounded-full bg-violet-50 text-violet-700 font-mono font-medium">Series A DD</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 tracking-tight">TechFlow Robotics Pvt. Ltd.</h3>
              <p class="text-xs text-slate-500 mt-0.5 leading-relaxed">Manufacturing & Industrial Robotics Automation</p>
            </div>

            <!-- Soft Metric Stack -->
            <div class="space-y-4 pt-2">
              <div>
                <div class="flex justify-between text-xs mb-1.5">
                  <span class="text-slate-600 font-medium">Workflow Progress</span>
                  <span class="text-slate-900 font-mono font-bold">72%</span>
                </div>
                <div class="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden">
                  <div class="bg-gradient-to-r from-violet-600 via-fuchsia-500 to-indigo-600 h-full w-[72%] rounded-full"></div>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-3 pt-1">
                <div class="p-3 rounded-2xl bg-slate-50/70 hover:bg-slate-50 transition-colors">
                  <span class="text-slate-500 block text-[10px] uppercase font-mono tracking-wider">Verified Files</span>
                  <span class="text-slate-900 font-bold font-mono text-base mt-0.5 block">184<span class="text-xs text-slate-400 font-normal">/230</span></span>
                  <span class="text-[10px] text-emerald-600 font-medium mt-0.5 block">80% Ingested</span>
                </div>
                <div class="p-3 rounded-2xl bg-amber-50/40 hover:bg-amber-50/60 transition-colors">
                  <span class="text-slate-500 block text-[10px] uppercase font-mono tracking-wider">Open Queries</span>
                  <span class="text-amber-700 font-bold font-mono text-base mt-0.5 block">23</span>
                  <span class="text-[10px] text-amber-600 font-medium mt-0.5 block">Across 4 streams</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Center: Multi-Domain Workstreams (Col 5) — Seamless List Rows -->
          <div class="lg:col-span-5 space-y-3">
            <div class="flex justify-between items-center pb-2 text-xs">
              <span class="font-bold text-slate-900 uppercase tracking-wider text-[10px] font-heading">Active Workstreams</span>
              <span class="text-[10px] text-slate-400 font-mono">Real-Time Progression</span>
            </div>

            <div class="space-y-1">
              
              <div class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-50/80 transition-all group">
                <div class="flex items-center gap-3">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <div>
                    <div class="text-xs font-semibold text-slate-800 group-hover:text-slate-950 transition-colors">Financial DD</div>
                    <div class="text-[10px] text-slate-400">P&L, Audit, Controls & Cash Flow</div>
                  </div>
                </div>
                <div class="text-right">
                  <span class="text-xs text-slate-900 font-mono font-bold">82%</span>
                  <span class="text-[10px] text-emerald-600 block">Verified</span>
                </div>
              </div>

              <div class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-50/80 transition-all group">
                <div class="flex items-center gap-3">
                  <span class="w-2 h-2 rounded-full bg-purple-500"></span>
                  <div>
                    <div class="text-xs font-semibold text-slate-800 group-hover:text-slate-950 transition-colors">Corporate & ROC</div>
                    <div class="text-[10px] text-slate-400">MCA Filings, PAS-3 & Cap Table</div>
                  </div>
                </div>
                <div class="text-right">
                  <span class="text-xs text-slate-900 font-mono font-bold">90%</span>
                  <span class="text-[10px] text-emerald-600 block">Reconciled</span>
                </div>
              </div>

              <div class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-50/80 transition-all group">
                <div class="flex items-center gap-3">
                  <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                  <div>
                    <div class="text-xs font-semibold text-slate-800 group-hover:text-slate-950 transition-colors">Legal Due Diligence</div>
                    <div class="text-[10px] text-slate-400">Contracts, Covenants & Litigation</div>
                  </div>
                </div>
                <div class="text-right">
                  <span class="text-xs text-slate-900 font-mono font-bold">68%</span>
                  <span class="text-[10px] text-amber-600 block">Reviewing</span>
                </div>
              </div>

              <div class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-50/80 transition-all group">
                <div class="flex items-center gap-3">
                  <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
                  <div>
                    <div class="text-xs font-semibold text-slate-800 group-hover:text-slate-950 transition-colors">Tech & Cyber</div>
                    <div class="text-[10px] text-slate-400">Architecture, Codebase & Infosec</div>
                  </div>
                </div>
                <div class="text-right">
                  <span class="text-xs text-slate-900 font-mono font-bold">74%</span>
                  <span class="text-[10px] text-slate-500 block">On Track</span>
                </div>
              </div>

            </div>
          </div>

          <!-- Right: Flash Risk Summary (Col 3) — Soft Gradient Callouts -->
          <div class="lg:col-span-3 flex flex-col justify-between space-y-4">
            <div>
              <div class="flex items-center justify-between pb-2">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-900 font-heading">Flash Findings</span>
                <span class="text-[10px] text-rose-700 font-mono font-bold bg-rose-50 px-2 py-0.5 rounded-full">04 Flagged</span>
              </div>

              <div class="space-y-2.5 pt-1">
                <div class="p-3 rounded-2xl bg-rose-50/60 hover:bg-rose-50/80 transition-colors text-[11px] space-y-1">
                  <div class="flex items-center justify-between">
                    <span class="text-[10px] font-mono font-bold text-rose-700 uppercase">Revenue Concentration</span>
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                  </div>
                  <p class="text-slate-700 text-[10px] leading-relaxed">Top client accounts for 54% of FY25 ARR.</p>
                </div>

                <div class="p-3 rounded-2xl bg-amber-50/60 hover:bg-amber-50/80 transition-colors text-[11px] space-y-1">
                  <div class="flex items-center justify-between">
                    <span class="text-[10px] font-mono font-bold text-amber-700 uppercase">IP Covenant Addendum</span>
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                  </div>
                  <p class="text-slate-700 text-[10px] leading-relaxed">Contractor assignment requires deed addendum.</p>
                </div>
              </div>
            </div>

            <div class="pt-2 text-center lg:text-left">
              <a href="#flash-dd" class="text-xs text-violet-700 hover:text-violet-900 inline-flex items-center gap-1.5 font-semibold transition-colors">
                <span>View Full Flash DD™ Radar</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>
